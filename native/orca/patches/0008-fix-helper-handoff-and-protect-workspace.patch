     return path;
 }
 
+bool workspace_destination_is_safe(const fs::path& workspace)
+{
+    boost::system::error_code ec;
+    const fs::file_status status = fs::symlink_status(workspace, ec);
+    if (ec || !fs::exists(status) || !fs::is_directory(status) ||
+        fs::is_symlink(status))
+        return false;
+
+    size_t direct_preset_directories = 0;
+    static constexpr std::array<const char*, 3> names{
+        "machine", "process", "filament"};
+    for (const char* name : names) {
+        ec.clear();
+        const fs::file_status child_status =
+            fs::symlink_status(workspace / name, ec);
+        if (!ec && fs::exists(child_status) &&
+            fs::is_directory(child_status) &&
+            !fs::is_symlink(child_status))
+            ++direct_preset_directories;
+    }
+    return direct_preset_directories < 2;
+}

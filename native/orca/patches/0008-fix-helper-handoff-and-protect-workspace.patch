+TEST_CASE("Preset Assistant rejects existing slicer preset roots as workspaces",
+          "[PresetAssistant][Workspace]")
+{
+    namespace fs = boost::filesystem;
+    const fs::path test_root =
+        fs::temp_directory_path() /
+        fs::unique_path("orca-assistant-%%%%-%%%%");
+    const fs::path slicer_root = test_root / "slicer-user";
+    const fs::path dedicated_root = test_root / "dedicated";
+
+    REQUIRE(fs::create_directories(slicer_root / "process"));
+    REQUIRE(fs::create_directories(slicer_root / "filament"));
+    REQUIRE(fs::create_directories(dedicated_root));
+
+    CHECK_FALSE(PresetAssistantBridge::is_workspace_destination_allowed(
+        slicer_root.string()));
+    CHECK(PresetAssistantBridge::is_workspace_destination_allowed(
+        dedicated_root.string()));
+
+    boost::system::error_code ec;
+    fs::remove_all(test_root, ec);
+    CHECK_FALSE(ec);
+}

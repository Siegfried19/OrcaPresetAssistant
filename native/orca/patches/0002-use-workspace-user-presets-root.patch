+    CHECK_THROWS_AS(bundle.configure_user_presets_root(config), Slic3r::RuntimeError);
+
+    TempPresetDir temp_dir;
+    const fs::path filesystem_root = temp_dir.path.root_path();
+    config.set("orca_preset_assistant", "workspace", filesystem_root.string());
+    CHECK_THROWS_AS(bundle.configure_user_presets_root(config), Slic3r::RuntimeError);
+
+    config.set("orca_preset_assistant", "workspace", (filesystem_root / "folder" / "..").string());
+    CHECK_THROWS_AS(bundle.configure_user_presets_root(config), Slic3r::RuntimeError);
+}

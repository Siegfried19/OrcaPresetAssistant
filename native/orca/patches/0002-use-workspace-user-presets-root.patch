+void PresetBundle::configure_user_presets_root(const AppConfig& config)
+{
+    static constexpr const char* config_section = "orca_preset_assistant";
+    static constexpr const char* workspace_key  = "workspace";
+
+    const std::string configured_workspace =
+        boost::algorithm::trim_copy(config.get(config_section, workspace_key));
+    m_external_user_presets_root.clear();
+    if (configured_workspace.empty())
+        return;
+
+    boost::filesystem::path workspace(configured_workspace);
+    workspace.make_preferred();
+    if (!workspace.is_absolute())
+        throw Slic3r::RuntimeError(
+            "Orca Preset Assistant workspace must be an absolute path: " +
+            configured_workspace);
+
+    workspace = boost::filesystem::absolute(workspace).lexically_normal().make_preferred();
+    if (workspace == workspace.root_path())
+        throw Slic3r::RuntimeError(
+            "Orca Preset Assistant workspace cannot be a filesystem root: " +
+            workspace.string());
+
+    boost::system::error_code ec;
+    if (!boost::filesystem::exists(workspace))
+        boost::filesystem::create_directories(workspace, ec);
+    if (ec || !boost::filesystem::is_directory(workspace))
+        throw Slic3r::RuntimeError(
+            "Unable to use Orca Preset Assistant workspace " + workspace.string() +
+            (ec ? ": " + ec.message() : ": path is not a directory"));
+
+    const boost::filesystem::path external_root =
+        (workspace / "UserPresets").make_preferred();
+    boost::filesystem::create_directories(external_root, ec);
+    if (ec)
+        throw Slic3r::RuntimeError(
+            "Unable to create user preset root " + external_root.string() +
+            ": " + ec.message());
+
+    static constexpr std::array<const char*, 3> preset_subdirs{
+        PRESET_PRINTER_NAME,
+        PRESET_PRINT_NAME,
+        PRESET_FILAMENT_NAME
+    };
+    for (const char* subdir : preset_subdirs) {
+        boost::filesystem::create_directories(external_root / subdir, ec);
+        if (ec)
+            throw Slic3r::RuntimeError(
+                "Unable to create user preset directory " +
+                (external_root / subdir).string() + ": " + ec.message());
+    }
+
+    m_external_user_presets_root = external_root;
+    BOOST_LOG_TRIVIAL(info)
+        << "PresetBundle: external user preset root enabled at "
+        << m_external_user_presets_root.string()
+        << "; OrcaCloud user preset sync is disabled";
+}
+
+boost::filesystem::path PresetBundle::resolve_user_presets_root(
+    const std::string& preset_folder) const
+{
+    if (!m_external_user_presets_root.empty())
+        return m_external_user_presets_root;
+
+    const std::string folder =
+        preset_folder.empty() ? DEFAULT_USER_FOLDER_NAME : preset_folder;
+    return (boost::filesystem::path(data_dir()) / PRESET_USER_DIR / folder)
+        .make_preferred();
+}
+
+void PresetBundle::ensure_user_presets_root(
+    const boost::filesystem::path& root) const
+{
+    boost::system::error_code ec;
+    boost::filesystem::create_directories(root, ec);
+    if (ec || !boost::filesystem::is_directory(root))
+        throw Slic3r::RuntimeError(
+            "Unable to use user preset directory " + root.string() +
+            (ec ? ": " + ec.message() : ": path is not a directory"));
+}

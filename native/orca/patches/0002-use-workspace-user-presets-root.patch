+TEST_CASE("Workspace root owns native user preset reads and writes", "[Preset][Workspace]")
+{
+    TempPresetDir temp_dir;
+    const fs::path workspace = temp_dir.path / "Orca Workspace";
+    const fs::path expected_root = workspace / "UserPresets";
+
+    AppConfig config;
+    config.set("orca_preset_assistant", "workspace", workspace.string());
+
+    PresetBundle bundle;
+    bundle.configure_user_presets_root(config);
+
+    REQUIRE(bundle.has_external_user_presets_root());
+    REQUIRE(fs::equivalent(bundle.external_user_presets_root(), expected_root));
+    CHECK(fs::is_directory(expected_root / PRESET_PRINTER_NAME));
+    CHECK(fs::is_directory(expected_root / PRESET_PRINT_NAME));
+    CHECK(fs::is_directory(expected_root / PRESET_FILAMENT_NAME));
+
+    // Account-folder switches must not change the external destination.
+    bundle.update_user_presets_directory("ignored-account-id");
+    REQUIRE(fs::equivalent(bundle.external_user_presets_root(), expected_root));
+
+    // Exercise the same PresetCollection::save_current_preset path used by the
+    // native Save preset flow and verify the resulting file stays in process/.
+    const std::string saved_name = "Workspace Resolver Test";
+    bundle.prints.save_current_preset(saved_name);
+    const Preset* saved = bundle.prints.find_preset(saved_name);
+    REQUIRE(saved != nullptr);
+    REQUIRE(fs::exists(saved->file));
+
+    const fs::path process_dir = expected_root / PRESET_PRINT_NAME;
+    const fs::path saved_parent = fs::path(saved->file).parent_path();
+    const bool saved_in_process_dir =
+        fs::equivalent(saved_parent, process_dir) ||
+        (saved_parent.filename() == "base" &&
+         fs::equivalent(saved_parent.parent_path(), process_dir));
+    CHECK(saved_in_process_dir);
+
+    // Logging out or switching cloud accounts must never delete the external root.
+    bundle.remove_user_presets_directory("ignored-account-id");
+    CHECK(fs::is_directory(expected_root));
+    CHECK(fs::exists(saved->file));
+
+    // Copying a bundle (used by validation and import paths) keeps the resolver.
+    PresetBundle copied(bundle);
+    REQUIRE(copied.has_external_user_presets_root());
+    CHECK(fs::equivalent(copied.external_user_presets_root(), expected_root));
+}

diff --git a/src/slic3r/GUI/PresetAssistantPanel.cpp b/src/slic3r/GUI/PresetAssistantPanel.cpp
new file mode 100644
index 00000000..129728f1
--- /dev/null
+++ b/src/slic3r/GUI/PresetAssistantPanel.cpp
@@ -0,0 +1,204 @@
+#include "PresetAssistantPanel.hpp"
+
+#include "GUI_App.hpp"
+#include "GUI_Utils.hpp"
+#include "Widgets/WebView.hpp"
+
+#include <libslic3r/AppConfig.hpp>
+#include <libslic3r/Utils.hpp>
+
+#include <boost/algorithm/string/case_conv.hpp>
+#include <boost/algorithm/string/predicate.hpp>
+#include <boost/algorithm/string/trim.hpp>
+#include <boost/filesystem.hpp>
+#include <boost/log/trivial.hpp>
+
+#include <array>
+#include <string>
+
+#include <wx/sizer.h>
+
+namespace Slic3r { namespace GUI {
+
+namespace {
+
+constexpr const char* CONFIG_SECTION = "orca_preset_assistant";
+constexpr const char* CONFIG_URL_KEY = "url";
+constexpr const char* STATIC_ENTRY   = "web/orca_preset_assistant/index.html";
+
+bool has_url_host_boundary(const std::string& url, const std::string& prefix)
+{
+    if (!boost::algorithm::starts_with(url, prefix))
+        return false;
+    if (url.size() == prefix.size())
+        return true;
+
+    const char next = url[prefix.size()];
+    return next == ':' || next == '/' || next == '?' || next == '#';
+}
+
+bool is_loopback_http_url(const std::string& value)
+{
+    const std::string url = boost::algorithm::to_lower_copy(value);
+    constexpr std::array<const char*, 6> prefixes{
+        "http://localhost",
+        "https://localhost",
+        "http://127.0.0.1",
+        "https://127.0.0.1",
+        "http://[::1]",
+        "https://[::1]",
+    };
+
+    for (const char* prefix : prefixes)
+        if (has_url_host_boundary(url, prefix))
+            return true;
+    return false;
+}
+
+wxString with_runtime_query(wxString url)
+{
+    const wxString language = wxGetApp().current_language_code_safe();
+    if (language.empty())
+        return url;
+
+    url += url.Contains("?") ? "&lang=" : "?lang=";
+    url += language;
+    return url;
+}
+
+const char* load_error_html()
+{
+    return R"HTML(<!doctype html>
+<html lang="en">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
+  <style>
+    :root { color-scheme: light dark; }
+    body { margin: 0; min-height: 100vh; display: grid; place-items: center;
+           background: #15171b; color: #f3f4f6; font: 14px system-ui, sans-serif; }
+    main { max-width: 560px; padding: 32px; border: 1px solid #353942;
+           border-radius: 12px; background: #202329; }
+    h1 { margin-top: 0; font-size: 20px; }
+    p { margin-bottom: 0; color: #bdc2cc; line-height: 1.6; }
+  </style>
+</head>
+<body>
+  <main>
+    <h1>Orca Preset Assistant</h1>
+    <p>The panel page could not be loaded. Check the bundled UI assets or the configured localhost development server.</p>
+  </main>
+</body>
+</html>)HTML";
+}
+
+} // namespace
+
+PresetAssistantPanel::PresetAssistantPanel(wxWindow* parent)
+    : wxPanel(parent, wxID_ANY, wxDefaultPosition, wxDefaultSize, wxTAB_TRAVERSAL)
+{
+    SetBackgroundColour(wxGetApp().get_window_default_clr());
+
+    auto* sizer = new wxBoxSizer(wxVERTICAL);
+    m_browser = WebView::CreateWebView(this, wxString());
+    if (!m_browser) {
+        SetSizer(sizer);
+        BOOST_LOG_TRIVIAL(error) << "PresetAssistantPanel: failed to create wxWebView";
+        return;
+    }
+
+    m_browser->SetBackgroundColour(wxGetApp().get_window_default_clr());
+    sizer->Add(m_browser, wxSizerFlags(1).Expand());
+    SetSizer(sizer);
+
+    m_browser->Bind(wxEVT_WEBVIEW_LOADED, &PresetAssistantPanel::on_loaded, this);
+    m_browser->Bind(wxEVT_WEBVIEW_ERROR, &PresetAssistantPanel::on_error, this);
+    m_browser->Bind(EVT_WEBVIEW_RECREATED, &PresetAssistantPanel::on_webview_recreated, this);
+
+    reload();
+}
+
+void PresetAssistantPanel::activate()
+{
+    if (!m_browser)
+        return;
+
+    const wxString configured_url = resolve_page_url();
+    if (configured_url != m_page_url || m_load_failed) {
+        m_page_url = configured_url;
+        load_page();
+    }
+    m_browser->SetFocus();
+}
+
+void PresetAssistantPanel::reload()
+{
+    if (!m_browser)
+        return;
+
+    m_page_url = resolve_page_url();
+    load_page();
+}
+
+wxString PresetAssistantPanel::resolve_page_url()
+{
+    m_using_localhost = false;
+
+    if (wxGetApp().app_config) {
+        std::string configured = boost::algorithm::trim_copy(
+            wxGetApp().app_config->get(CONFIG_SECTION, CONFIG_URL_KEY));
+        if (!configured.empty()) {
+            if (is_loopback_http_url(configured)) {
+                m_using_localhost = true;
+                return with_runtime_query(from_u8(configured));
+            }
+            BOOST_LOG_TRIVIAL(warning)
+                << "PresetAssistantPanel: ignoring non-loopback configured URL";
+        }
+    }
+
+    const boost::filesystem::path entry =
+        (boost::filesystem::path(resources_dir()) / STATIC_ENTRY).make_preferred();
+    if (!boost::filesystem::exists(entry))
+        BOOST_LOG_TRIVIAL(error)
+            << "PresetAssistantPanel: bundled entry page does not exist: " << entry.string();
+
+    return with_runtime_query(wxString("file://") + from_u8(entry.string()));
+}
+
+void PresetAssistantPanel::load_page()
+{
+    if (!m_browser || m_page_url.empty())
+        return;
+
+    m_load_failed = false;
+    m_showing_error_page = false;
+    m_browser->EnableContextMenu(m_using_localhost);
+    WebView::LoadUrl(m_browser, m_page_url);
+}
+
+void PresetAssistantPanel::on_loaded(wxWebViewEvent& event)
+{
+    if (!m_showing_error_page)
+        m_load_failed = false;
+    event.Skip();
+}
+
+void PresetAssistantPanel::on_error(wxWebViewEvent& event)
+{
+    m_load_failed = true;
+    m_showing_error_page = true;
+    BOOST_LOG_TRIVIAL(error)
+        << "PresetAssistantPanel: failed to load page: " << into_u8(event.GetURL());
+    if (m_browser)
+        m_browser->SetPage(wxString::FromUTF8(load_error_html()), "about:blank");
+    event.Skip();
+}
+
+void PresetAssistantPanel::on_webview_recreated(wxCommandEvent& event)
+{
+    load_page();
+    event.Skip();
+}
+
+}} // namespace Slic3r::GUI

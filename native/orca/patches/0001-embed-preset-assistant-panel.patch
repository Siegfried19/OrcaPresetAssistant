@@ -0,0 +1,45 @@
+#ifndef slic3r_GUI_PresetAssistantPanel_hpp_
+#define slic3r_GUI_PresetAssistantPanel_hpp_
+
+#include <wx/panel.h>
+#include <wx/string.h>
+#include <wx/webview.h>
+
+class wxCommandEvent;
+
+namespace Slic3r { namespace GUI {
+
+// Product-owned main-window page for the Orca Preset Assistant.
+//
+// The page loads bundled static UI by default. Developers may set
+// [orca_preset_assistant] url=http://localhost:<port> in OrcaSlicer.conf.
+// Only loopback HTTP(S) URLs are accepted.
+class PresetAssistantPanel final : public wxPanel
+{
+public:
+    explicit PresetAssistantPanel(wxWindow* parent);
+
+    // Re-resolve the configured URL when the page becomes active. This lets a
+    // developer start or restart the localhost UI without restarting Orca.
+    void activate();
+    void reload();
+
+    const wxString& page_url() const { return m_page_url; }
+
+private:
+    wxString resolve_page_url();
+    void     load_page();
+    void     on_loaded(wxWebViewEvent& event);
+    void     on_error(wxWebViewEvent& event);
+    void     on_webview_recreated(wxCommandEvent& event);
+
+    wxWebView* m_browser{nullptr};
+    wxString   m_page_url;
+    bool       m_using_localhost{false};
+    bool       m_load_failed{false};
+    bool       m_showing_error_page{false};
+};
+
+}} // namespace Slic3r::GUI
+
+#endif // slic3r_GUI_PresetAssistantPanel_hpp_

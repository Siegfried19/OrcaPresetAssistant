+    CHECK(PresetAssistantBridge::repeat_serialized_scalar("20", 4) ==
+          "20,20,20,20");
+    CHECK_THROWS_AS(
+        PresetAssistantBridge::repeat_serialized_scalar("20", 0),
+        std::invalid_argument);
+}

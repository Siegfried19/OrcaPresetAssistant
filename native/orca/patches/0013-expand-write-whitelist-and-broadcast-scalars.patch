+std::vector<double> parse_numeric_values(std::string serialized,
+                                         const WriteRule& rule,
+                                         const std::string& key)
+{
+    std::vector<std::string> parts = serialized_parts(serialized, rule, key);
+    std::vector<double> values;
+    values.reserve(parts.size());
+    for (std::string& part : parts) {
+        if (rule.scalar_kind == ScalarKind::Percent && part.back() == '%') {
+            part.pop_back();
+            boost::algorithm::trim(part);
+        }
+
+        size_t consumed = 0;
+        double value = 0.;
+        try {
+            value = std::stod(part, &consumed);
+        } catch (const std::exception&) {
+            throw BridgeError(
+                "INVALID_SETTING_VALUE",
+                "Setting " + key + " must contain finite " +
+                    scalar_kind_name(rule.scalar_kind) + " values");
+        }
+        if (consumed != part.size() || !std::isfinite(value))
+            throw BridgeError(
+                "INVALID_SETTING_VALUE",
+                "Setting " + key + " must contain finite " +
+                    scalar_kind_name(rule.scalar_kind) + " values");
+        if (rule.scalar_kind == ScalarKind::Integer && std::floor(value) != value)
+            throw BridgeError(
+                "INVALID_SETTING_VALUE",
+                "Setting " + key + " must contain integer values");
+        values.push_back(value);
+    }
+    return values;
+}

+std::string PresetAssistantBridge::repeat_serialized_scalar(
+    const std::string& value,
+    std::size_t count)
+{
+    if (value.empty() || count == 0)
+        throw std::invalid_argument(
+            "Serialized scalar repetition requires a value and a positive count");
+
+    std::ostringstream repeated;
+    for (std::size_t index = 0; index < count; ++index) {
+        if (index != 0)
+            repeated << ',';
+        repeated << value;
+    }
+    return repeated.str();
+}

+void append_model_source_file(json& source_files,
+                              std::set<std::string>& seen,
+                              const std::string& candidate)
+{
+    if (candidate.empty())
+        return;
+    boost::system::error_code error;
+    fs::path source(candidate);
+    if (!source.is_absolute() ||
+        !fs::exists(source, error) || error ||
+        !fs::is_regular_file(source, error) || error)
+        return;
+    const std::string extension =
+        boost::algorithm::to_lower_copy(source.extension().string());
+    if (extension != ".stl" && extension != ".3mf")
+        return;
+    source = fs::canonical(source, error);
+    if (error)
+        return;
+    source.make_preferred();
+    const std::string normalized = source.string();
+    if (seen.emplace(normalized).second)
+        source_files.push_back(normalized);
+}

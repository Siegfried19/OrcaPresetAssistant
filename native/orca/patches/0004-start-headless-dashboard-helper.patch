+bool PresetAssistantPanel::has_development_url() const
+{
+    if (!wxGetApp().app_config)
+        return false;
+    const std::string configured = boost::algorithm::trim_copy(
+        wxGetApp().app_config->get(CONFIG_SECTION, CONFIG_URL_KEY));
+    return !configured.empty() && is_loopback_http_url(configured);
+}
+
+wxString PresetAssistantPanel::resolve_helper_executable() const
+{
+    namespace fs = boost::filesystem;
+    const fs::path bundled =
+        (fs::path(resources_dir()) / HELPER_ENTRY).make_preferred();
+    if (fs::exists(bundled) && fs::is_regular_file(bundled))
+        return from_path(bundled);
+    return {};
+}
+
+void PresetAssistantPanel::start_helper()
+{
+    if (has_development_url() || m_helper_pid > 0)
+        return;
+
+#ifndef _WIN32
+    BOOST_LOG_TRIVIAL(warning)
+        << "PresetAssistantPanel: packaged helper launch is currently Windows-only";
+    return;
+#else
+    namespace fs = boost::filesystem;
+    const wxString executable = resolve_helper_executable();
+    if (executable.empty()) {
+        BOOST_LOG_TRIVIAL(warning)
+            << "PresetAssistantPanel: packaged headless helper is not installed";
+        return;
+    }
+
+    m_helper_session_token =
+        boost::uuids::to_string(boost::uuids::random_generator()());
+    const fs::path state_path =
+        (fs::temp_directory_path() /
+         ("orca-preset-assistant-" +
+          boost::uuids::to_string(boost::uuids::random_generator()()) +
+          ".json"))
+            .make_preferred();
+    if (fs::exists(state_path)) {
+        BOOST_LOG_TRIVIAL(error)
+            << "PresetAssistantPanel: helper state path unexpectedly exists";
+        return;
+    }
+    m_helper_state_path = from_path(state_path);
+
+    std::vector<wxString> argument_storage{
+        executable,
+        "--serve",
+        "--host",
+        "127.0.0.1",
+        "--port",
+        "0",
+        "--session-token",
+        from_u8(m_helper_session_token),
+        "--state-file",
+        m_helper_state_path,
+        "--parent-pid",
+        wxString::Format("%lu", static_cast<unsigned long>(wxGetProcessId())),
+    };
+    std::vector<const wchar_t*> arguments;
+    arguments.reserve(argument_storage.size() + 1);
+    for (const wxString& argument : argument_storage)
+        arguments.push_back(argument.wc_str());
+    arguments.push_back(nullptr);
+
+    auto process = std::make_unique<wxProcess>();
+    const long pid = wxExecute(
+        arguments.data(),
+        wxEXEC_ASYNC | wxEXEC_HIDE_CONSOLE,
+        process.get());
+    if (pid <= 0) {
+        BOOST_LOG_TRIVIAL(error)
+            << "PresetAssistantPanel: failed to launch packaged headless helper";
+        m_helper_state_path.clear();
+        m_helper_session_token.clear();
+        return;
+    }
+
+    m_helper_pid = pid;
+    m_helper_process = std::move(process);
+    m_helper_ready_attempts = 0;
+    m_helper_ready_timer.Start(100);
+#endif
+}
+
+void PresetAssistantPanel::stop_helper()
+{
+    m_helper_ready_timer.Stop();
+#ifdef _WIN32
+    if (m_helper_pid > 0 && wxProcess::Exists(m_helper_pid)) {
+        wxKillError kill_error = wxKILL_OK;
+        wxProcess::Kill(
+            m_helper_pid,
+            wxSIGTERM,
+            &kill_error,
+            wxKILL_CHILDREN);
+        if (kill_error != wxKILL_OK)
+            BOOST_LOG_TRIVIAL(warning)
+                << "PresetAssistantPanel: helper did not acknowledge shutdown";
+    }
+#endif
+    m_helper_process.reset();
+    m_helper_pid = 0;
+
+    if (!m_helper_state_path.empty()) {
+        boost::system::error_code error;
+        boost::filesystem::remove(
+            into_path(m_helper_state_path),
+            error);
+        if (error)
+            BOOST_LOG_TRIVIAL(warning)
+                << "PresetAssistantPanel: could not remove helper state file";
+    }
+    m_helper_state_path.clear();
+    m_helper_session_token.clear();
+}
+
+void PresetAssistantPanel::on_helper_ready_timer(wxTimerEvent& event)
+{
+    event.Skip();
+    if (m_helper_pid <= 0 || m_helper_state_path.empty()) {
+        m_helper_ready_timer.Stop();
+        return;
+    }
+    if (++m_helper_ready_attempts > 150) {
+        BOOST_LOG_TRIVIAL(error)
+            << "PresetAssistantPanel: helper readiness timed out";
+        stop_helper();
+        return;
+    }
+    if (!boost::filesystem::exists(into_path(m_helper_state_path)))
+        return;
+
+    boost::nowide::ifstream stream(
+        into_path(m_helper_state_path).string(),
+        std::ios::binary);
+    if (!stream)
+        return;
+    std::ostringstream buffer;
+    buffer << stream.rdbuf();
+    const nlohmann::json state =
+        nlohmann::json::parse(buffer.str(), nullptr, false);
+    if (state.is_discarded() || !state.is_object())
+        return;
+
+    auto schema = state.find("schemaVersion");
+    auto pid = state.find("pid");
+    auto generated_at = state.find("generatedAt");
+    auto origin = state.find("origin");
+    auto port = state.find("port");
+    if (state.size() != 5 ||
+        schema == state.end() || !schema->is_number_unsigned() ||
+        schema->get<unsigned int>() != 1 ||
+        pid == state.end() || !pid->is_number_integer() ||
+        pid->get<long>() != m_helper_pid ||
+        generated_at == state.end() || !generated_at->is_string() ||
+        generated_at->get<std::string>().empty() ||
+        origin == state.end() || !origin->is_string() ||
+        port == state.end() || !port->is_number_unsigned() ||
+        port->get<unsigned int>() == 0 ||
+        port->get<unsigned int>() > 65535) {
+        BOOST_LOG_TRIVIAL(error)
+            << "PresetAssistantPanel: helper readiness file is invalid";
+        stop_helper();
+        return;
+    }
+
+    const std::string origin_value = origin->get<std::string>();
+    const std::string expected_origin =
+        "http://127.0.0.1:" +
+        std::to_string(port->get<unsigned int>());
+    if (origin_value != expected_origin ||
+        !is_loopback_http_url(origin_value) ||
+        m_helper_session_token.size() < 32) {
+        BOOST_LOG_TRIVIAL(error)
+            << "PresetAssistantPanel: helper returned an untrusted page";
+        stop_helper();
+        return;
+    }
+    const std::string page_value =
+        origin_value + "/#session=" + m_helper_session_token;
+
+    m_helper_ready_timer.Stop();
+    boost::system::error_code remove_error;
+    boost::filesystem::remove(
+        into_path(m_helper_state_path),
+        remove_error);
+    m_helper_state_path.clear();
+    m_helper_session_token.clear();
+    m_helper_page_url = from_u8(page_value);
+    m_page_url = resolve_page_url();
+    load_page();
+}

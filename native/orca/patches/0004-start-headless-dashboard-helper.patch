+wxString PresetAssistantPanel::append_language_query(
+    wxString url,
+    const wxString& language)
+{
+    if (language.empty())
+        return url;
+
+    wxString fragment;
+    const int fragment_pos = url.Find('#');
+    if (fragment_pos != wxNOT_FOUND) {
+        fragment = url.Mid(fragment_pos);
+        url = url.Left(fragment_pos);
+    }
+    url += url.Contains("?") ? "&lang=" : "?lang=";
+    url += language;
+    return url + fragment;
+}
 

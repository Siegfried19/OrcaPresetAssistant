+
+struct PresetAssistantBridge::RollbackRecord
+{
+    std::string id;
+    uint64_t    valid_at_revision{0};
+    std::string destination;
+    std::string original_preset_name;
+    std::string target_preset_name;
+    json        before;
+    json        after;
+};
+
+PresetAssistantBridge::PresetAssistantBridge(std::string token)
+    : m_token(std::move(token))
+{
+    if (m_token.empty())
+        throw std::invalid_argument("Preset Assistant bridge token cannot be empty");
+}
+
+PresetAssistantBridge::~PresetAssistantBridge() = default;
+
+bool PresetAssistantBridge::is_trusted_source(
+    const std::string& candidate_url,
+    const std::string& trusted_page_url)
+{
+    const std::string trusted_origin = http_origin(trusted_page_url);
+    if (!trusted_origin.empty())
+        return http_origin(candidate_url) == trusted_origin;
+
+    const std::string trusted_file = normalized_file_url(trusted_page_url);
+    const std::string candidate_file = normalized_file_url(candidate_url);
+    return !trusted_file.empty() && candidate_file == trusted_file;
+}
+
+bool PresetAssistantBridge::preserves_created_preset_on_rollback(
+    const std::string& destination)
+{
+    return destination == "save-as-new-preset";
+}
+
+bool PresetAssistantBridge::has_explicit_panel_approval(const json& params)
+{
+    if (!params.is_object())
+        return false;
+    auto approved_at = params.find("approvedAt");
+    return approved_at != params.end() && approved_at->is_string() &&
+           !approved_at->get<std::string>().empty();
+}
+
+json PresetAssistantBridge::handle_message(
+    const std::string& raw_message,
+    const std::string& source_url,
+    const std::string& trusted_page_url)
+{
+    std::string request_id;
+    if (raw_message.size() > MAX_MESSAGE_BYTES)
+        return error_response(request_id, "MESSAGE_TOO_LARGE",
+                              "Native request exceeds the size limit");
+
+    json request = json::parse(raw_message, nullptr, false);
+    if (request.is_discarded() || !request.is_object())
+        return error_response(request_id, "MALFORMED_JSON",
+                              "Native request must be a JSON object");
+
+    auto id_it = request.find("requestId");
+    if (id_it != request.end() && id_it->is_string())
+        request_id = id_it->get<std::string>();
+
+    try {
+        reject_unknown_keys(
+            request,
+            {"requestId", "version", "token", "method", "expectedRevision", "params"},
+            "request");
+        if (request_id.empty() || request_id.size() > 128)
+            throw BridgeError("INVALID_REQUEST", "requestId is required and must be at most 128 characters");
+        if (!is_trusted_source(source_url, trusted_page_url))
+            throw BridgeError("UNTRUSTED_SOURCE", "Native request source is not trusted");
+        if (!request.contains("version") || !request["version"].is_number_unsigned() ||
+            request["version"].get<uint64_t>() != PROTOCOL_VERSION)
+            throw BridgeError("UNSUPPORTED_PROTOCOL", "Unsupported native bridge protocol version");
+        if (!request.contains("token") || !request["token"].is_string() ||
+            request["token"].get<std::string>() != m_token)
+            throw BridgeError("AUTHENTICATION_FAILED", "Native bridge authentication failed");
+
+        const std::string method = require_string(request, "method");
+        if (!is_supported_method(method))
+            throw BridgeError("UNKNOWN_METHOD", "Unknown native method: " + method);
+
+        const bool mutation = is_mutation_method(method);
+        uint64_t expected_revision = 0;
+        if (mutation) {
+            auto revision_it = request.find("expectedRevision");
+            if (revision_it == request.end() || !revision_it->is_number_unsigned())
+                throw BridgeError("INVALID_REQUEST",
+                                  "Mutating requests require expectedRevision");
+            expected_revision = revision_it->get<uint64_t>();
+            // Early check keeps stale requests deterministic even when Orca is
+            // not fully initialized (and is directly unit-testable).
+            if (expected_revision != m_revision)
+                throw BridgeError("REVISION_CONFLICT",
+                                  "Native state revision is stale");
+        }
+
+        const json params = request.contains("params") ? request["params"] : json::object();
+        if (!params.is_object())
+            throw BridgeError("INVALID_REQUEST", "params must be an object");
+        if (method == "proposal.apply") {
+            if (!has_explicit_panel_approval(params))
+                throw BridgeError(
+                    "CONSENT_REQUIRED",
+                    "proposal.apply requires a non-empty panel approval timestamp");
+        }
+
+        if (!wxIsMainThread())
+            throw BridgeError("WRONG_THREAD", "Native bridge must run on Orca's UI thread");
+        (void) require_app();
+        sync_revision();
+        if (mutation && expected_revision != m_revision)
+            throw BridgeError("REVISION_CONFLICT",
+                              "Native state changed before the request was applied");
+
+        return success_response(request_id, dispatch(method, params));
+    } catch (const BridgeError& error) {
+        BOOST_LOG_TRIVIAL(warning)
+            << "PresetAssistantBridge request " << request_id
+            << " failed with " << error.code << ": " << error.what();
+        return error_response(request_id, error.code, error.what());
+    } catch (const std::exception& error) {
+        BOOST_LOG_TRIVIAL(error)
+            << "PresetAssistantBridge request " << request_id
+            << " failed: " << error.what();
+        return error_response(request_id, "INTERNAL_ERROR",
+                              "Orca could not complete the native request");
+    }
+}
+
+json PresetAssistantBridge::dispatch(const std::string& method, const json& params)
+{
+    if (method == "state.get")          return state_get(params);
+    if (method == "settings.get")       return settings_get(params);
+    if (method == "project.get")        return project_get(params);
+    if (method == "project.export-copy") return project_export_copy(params);
+    if (method == "workspace.get")      return workspace_get(params);
+    if (method == "workspace.set")      return workspace_set(params);
+    if (method == "workspace.choose")   return workspace_choose(params);
+    if (method == "presets.refresh")    return presets_refresh(params);
+    if (method == "proposal.apply")     return proposal_apply(params);
+    if (method == "proposal.rollback")  return proposal_rollback(params);
+    if (method == "print.pending.get")  return pending_print_get(params);
+    throw BridgeError("UNKNOWN_METHOD", "Unknown native method: " + method);
+}
+
+json PresetAssistantBridge::state_get(const json& params)
+{
+    reject_unknown_keys(params, {}, "state.get params");
+    PresetBundle& bundle = require_bundle();
+    Plater& plater = require_plater();
+    AppConfig& app_config = require_app_config();
+
+    return {
+        {"protocolVersion", PROTOCOL_VERSION},
+        {"revision", m_revision},
+        {"workspaceConfigured", !app_config.get(CONFIG_SECTION, CONFIG_WORKSPACE_KEY).empty()},
+        {"workspaceActive", bundle.has_external_user_presets_root()},
+        {"restartRequired", m_pending_restart},
+        {"projectDirty", plater.is_project_dirty()},
+        {"presetsDirty", plater.is_presets_dirty()},
+        {"presets", current_preset_state(bundle)},
+        {"pendingPrintArchiveAvailable", !m_pending_print_archive.is_null()},
+        {"modelGeometryIncluded", false},
+    };
+}
+
+json PresetAssistantBridge::settings_get(const json& params)
+{
+    reject_unknown_keys(params, {"authorization"}, "settings.get params");
+    if (require_string(params, "authorization") != "settings:read")
+        throw BridgeError("CONSENT_REQUIRED",
+                          "settings.get requires settings:read authorization");
+
+    PresetBundle& bundle = require_bundle();
+    return {
+        {"authorization", "settings:read"},
+        {"presets", current_preset_state(bundle)},
+        {"effective", serialized_settings(bundle.full_config())},
+        {"modelGeometryIncluded", false},
+    };
+}
+
+json PresetAssistantBridge::project_get(const json& params)
+{
+    reject_unknown_keys(params, {"authorization"}, "project.get params");
+    const std::string authorization = require_string(params, "authorization");
+    if (authorization != "project:summary" &&
+        authorization != "project:placement")
+        throw BridgeError("CONSENT_REQUIRED",
+                          "project.get requires project:summary or project:placement authorization");
+
+    Plater& plater = require_plater();
+    json result = {
+        {"authorization", authorization},
+        {"projectDirty", plater.is_project_dirty()},
+        {"presetsDirty", plater.is_presets_dirty()},
+        {"hasLoadedObjects", !plater.model().objects.empty()},
+        {"meshIncluded", false},
+        {"sourcePathsIncluded", false},
+    };
+    if (authorization == "project:placement") {
+        result["placement"] = project_placement_summary(plater);
+        result["objectCountIncluded"] = true;
+        result["placementIncluded"] = true;
+    } else {
+        result["objectCountIncluded"] = false;
+        result["placementIncluded"] = false;
+    }
+    return result;
+}
+
+json PresetAssistantBridge::project_export_copy(const json& params)
+{
+    reject_unknown_keys(
+        params,
+        {"authorization", "destinationPath"},
+        "project.export-copy params");
+    if (require_string(params, "authorization") != "project:export-copy")
+        throw BridgeError(
+            "CONSENT_REQUIRED",
+            "project.export-copy requires project:export-copy authorization");
+
+    const fs::path output = fs::absolute(
+        fs::path(require_string(params, "destinationPath")))
+        .lexically_normal()
+        .make_preferred();
+    if (!output.is_absolute() ||
+        boost::algorithm::to_lower_copy(output.extension().string()) != ".3mf")
+        throw BridgeError(
+            "INVALID_EXPORT_PATH",
+            "Project archive copy must be an absolute .3mf path");
+
+    AppConfig& app_config = require_app_config();
+    const std::string configured =
+        app_config.get(CONFIG_SECTION, CONFIG_WORKSPACE_KEY);
+    if (configured.empty())
+        throw BridgeError(
+            "WORKSPACE_NOT_CONFIGURED",
+            "A workspace is required before exporting an archive copy");
+    const fs::path history_root =
+        (normalized_workspace_path(configured) / "PrintHistory")
+            .lexically_normal()
+            .make_preferred();
+    if (!fs::exists(history_root) || !fs::is_directory(history_root))
+        throw BridgeError(
+            "ARCHIVE_PATH_NOT_READY",
+            "The workspace helper must prepare PrintHistory before export");
+    if (!path_is_within(output, history_root) ||
+        !fs::exists(output.parent_path()) ||
+        !fs::is_directory(output.parent_path()) ||
+        !path_is_within(output.parent_path(), history_root))
+        throw BridgeError(
+            "EXPORT_PATH_NOT_ALLOWED",
+            "Project archive copy must stay inside the prepared PrintHistory directory");
+    if (fs::exists(output))
+        throw BridgeError(
+            "EXPORT_PATH_CONFLICT",
+            "Project archive copy destination already exists");
+
+    Plater& plater = require_plater();
+    if (plater.export_3mf(output, SaveStrategy::Silence) < 0 ||
+        !fs::exists(output) || !fs::is_regular_file(output))
+        throw BridgeError(
+            "PROJECT_EXPORT_FAILED",
+            "Orca could not export the requested project archive copy");
+
+    return {
+        {"authority", "orca"},
+        {"status", "exported"},
+        {"path", output.string()},
+        {"currentProjectPathChanged", false},
+    };
+}
+
+json PresetAssistantBridge::workspace_get(const json& params)
+{
+    reject_unknown_keys(params, {}, "workspace.get params");
+    AppConfig& app_config = require_app_config();
+    PresetBundle& bundle = require_bundle();
+
+    const std::string configured =
+        app_config.get(CONFIG_SECTION, CONFIG_WORKSPACE_KEY);
+    std::string active_workspace;
+    std::string active_root;
+    if (bundle.has_external_user_presets_root()) {
+        active_root = bundle.external_user_presets_root().string();
+        active_workspace = bundle.external_user_presets_root().parent_path().string();
+    }
+
+    bool restart_required = m_pending_restart;
+    if (!configured.empty() && !active_workspace.empty()) {
+        try {
+            restart_required = restart_required ||
+                normalized_path_for_compare(normalized_workspace_path(configured)) !=
+                normalized_path_for_compare(fs::path(active_workspace));
+        } catch (const BridgeError&) {
+            restart_required = true;
+        }
+    } else if (configured.empty() != active_workspace.empty()) {
+        restart_required = true;
+    }
+
+    return {
+        {"configuredWorkspace", configured},
+        {"activeWorkspace", active_workspace},
+        {"activeUserPresetsRoot", active_root},
+        {"restartRequired", restart_required},
+    };
+}
+
+json PresetAssistantBridge::workspace_set(const json& params)
+{
+    reject_unknown_keys(params, {"workspace"}, "workspace.set params");
+    AppConfig& app_config = require_app_config();
+    const fs::path workspace =
+        normalized_workspace_path(require_string(params, "workspace"));
+
+    const std::string old_value =
+        app_config.get(CONFIG_SECTION, CONFIG_WORKSPACE_KEY);
+    const std::string new_value = workspace.string();
+    if (old_value == new_value)
+        return workspace_get(json::object());
+
+    app_config.set(CONFIG_SECTION, CONFIG_WORKSPACE_KEY, new_value);
+    try {
+        app_config.save();
+    } catch (...) {
+        app_config.set(CONFIG_SECTION, CONFIG_WORKSPACE_KEY, old_value);
+        throw;
+    }
+
+    m_pending_restart = true;
+    clear_rollback();
+    advance_revision();
+    json result = workspace_get(json::object());
+    result["saved"] = true;
+    result["restartRequired"] = true;
+    result["activation"] = "restart-orca";
+    return result;
+}
+
+json PresetAssistantBridge::workspace_choose(const json& params)
+{
+    reject_unknown_keys(params, {}, "workspace.choose params");
+    GUI_App& app = require_app();
+    AppConfig& app_config = require_app_config();
+    const wxString initial = from_u8(
+        app_config.get(CONFIG_SECTION, CONFIG_WORKSPACE_KEY));
+    wxDirDialog dialog(
+        app.mainframe,
+        _L("Choose Orca Preset Assistant workspace"),
+        initial,
+        wxDD_DEFAULT_STYLE | wxDD_DIR_MUST_EXIST);
+    if (dialog.ShowModal() != wxID_OK)
+        return {{"cancelled", true}, {"revision", m_revision}};
+
+    return workspace_set({{"workspace", into_u8(dialog.GetPath())}});
+}
+
+json PresetAssistantBridge::presets_refresh(const json& params)
+{
+    reject_unknown_keys(params, {}, "presets.refresh params");
+    // Repeating load_user_presets() skips duplicate names and would present a
+    // false success. Until a full user-only unload/reload transaction exists,
+    // an explicit restart is the only authoritative refresh.
+    throw BridgeError(
+        "RESTART_REQUIRED",
+        "Safe preset refresh requires restarting Orca; no files were reloaded");
+}
+
+json PresetAssistantBridge::proposal_apply(const json& params)
+{
+    reject_unknown_keys(
+        params,
+        {"destination", "presetType", "expectedPresetName", "newName", "changes", "reason", "approvedAt"},
+        "proposal.apply params");
+    const std::string destination = require_string(params, "destination");
+    const std::string preset_type = require_string(params, "presetType");
+    const std::string expected_preset_name =
+        require_string(params, "expectedPresetName");
+    const std::string reason      = require_string(params, "reason");
+    const std::string approved_at = require_string(params, "approvedAt");
+    (void) reason;
+    (void) approved_at;
+
+    if (preset_type != "process")
+        throw BridgeError("UNSUPPORTED_PRESET_TYPE",
+                          "The current native write whitelist supports process settings only");
+    if (destination != "current-project" &&
+        destination != "update-current-preset" &&
+        destination != "save-as-new-preset")
+        throw BridgeError("INVALID_DESTINATION",
+                          "An explicit supported destination is required");
+    if (!params.contains("changes"))
+        throw BridgeError("INVALID_REQUEST", "changes is required");
+
+    PresetBundle& bundle = require_bundle();
+    Tab& tab = require_process_tab();
+    PresetCollection& collection = *tab.get_presets();
+    const Preset selected_before = collection.get_selected_preset();
+    const DynamicPrintConfig config_before(*tab.get_config());
+    if (selected_before.name != expected_preset_name)
+        throw BridgeError(
+            "PRESET_SELECTION_CHANGED",
+            "The selected process preset changed after the proposal was prepared");
+
+    if (destination != "current-project" &&
+        !bundle.has_external_user_presets_root())
+        throw BridgeError("WORKSPACE_NOT_ACTIVE",
+                          "Permanent preset writes require an active external workspace");
+
+    std::string target_name = selected_before.name;
+    if (destination == "update-current-preset") {
+        if (!selected_before.is_user() || !selected_before.can_overwrite() ||
+            selected_before.is_system || selected_before.is_project_embedded)
+            throw BridgeError("SYSTEM_PRESET_PROTECTED",
+                              "The current preset is not an overwriteable user preset");
+    } else if (destination == "save-as-new-preset") {
+        target_name = validated_new_preset_name(params);
+        if (collection.find_preset(target_name, false, true) != nullptr)
+            throw BridgeError("PRESET_NAME_CONFLICT",
+                              "A preset with this name already exists");
+    } else if (params.contains("newName")) {
+        throw BridgeError("INVALID_REQUEST",
+                          "newName is only valid for save-as-new-preset");
+    }
+
+    ValidatedChangeSet validated =
+        validate_process_changes(params["changes"], config_before, bundle);
+    bool changed = false;
+    for (auto it = validated.deltas.begin(); it != validated.deltas.end(); ++it)
+        changed = changed ||
+            it.value()["before"].get<std::string>() !=
+            it.value()["after"].get<std::string>();
+    if (!changed) {
+        return {
+            {"authority", "orca"},
+            {"status", "unchanged"},
+            {"applied", false},
+            {"destination", destination},
+            {"targetPreset", target_name},
+            {"changes", validated.deltas},
+            {"before", validated.before},
+            {"after", validated.after},
+            {"reason", "already-at-requested-values"},
+        };
+    }
+
+    auto restore_after_failure = [&]() {
+        try {
+            if (destination == "save-as-new-preset") {
+                Preset* created = collection.find_preset(target_name, false, true);
+                if (created != nullptr && created->is_user())
+                    collection.delete_preset(target_name);
+                collection.select_preset_by_name(selected_before.name, true);
+                tab.load_current_preset();
+            } else {
+                tab.load_config(config_before);
+                if (destination == "update-current-preset")
+                    tab.save_preset(selected_before.name, false, false);
+            }
+        } catch (const std::exception& rollback_error) {
+            BOOST_LOG_TRIVIAL(error)
+                << "PresetAssistantBridge failed to restore after save error: "
+                << rollback_error.what();
+        }
+    };
+
+    try {
+        tab.load_config(validated.updated);
+        if (destination == "current-project") {
+            mark_project_dirty();
+        } else {
+            tab.save_preset(target_name, false, false);
+            Preset* saved = collection.find_preset(target_name, false, true);
+            if (saved == nullptr || !saved->is_user() || !fs::exists(saved->file) ||
+                !path_is_within(saved->file, bundle.external_user_presets_root()))
+                throw BridgeError("SAVE_VERIFICATION_FAILED",
+                                  "Orca did not create the expected workspace preset");
+            fs::path info_path(saved->file);
+            info_path.replace_extension(".info");
+            if (!fs::exists(info_path) || !values_match(saved->config, validated.after))
+                throw BridgeError("SAVE_VERIFICATION_FAILED",
+                                  "Saved preset verification failed");
+        }
+
+        if (!values_match(*tab.get_config(), validated.after))
+            throw BridgeError("APPLY_VERIFICATION_FAILED",
+                              "Live settings do not contain the requested values");
+    } catch (...) {
+        restore_after_failure();
+        throw;
+    }
+
+    advance_revision();
+    m_rollback = std::make_unique<RollbackRecord>();
+    m_rollback->id                   = new_id();
+    m_rollback->valid_at_revision    = m_revision;
+    m_rollback->destination          = destination;
+    m_rollback->original_preset_name = selected_before.name;
+    m_rollback->target_preset_name   = target_name;
+    m_rollback->before               = validated.before;
+    m_rollback->after                = validated.after;
+
+    return {
+        {"authority", "orca"},
+        {"status", "applied"},
+        {"applied", true},
+        {"destination", destination},
+        {"targetPreset", target_name},
+        {"changes", validated.deltas},
+        {"before", validated.before},
+        {"after", validated.after},
+        {"rollbackGuard", {
+            {"id", m_rollback->id},
+            {"validAtRevision", m_rollback->valid_at_revision},
+        }},
+    };
+}
+
+json PresetAssistantBridge::proposal_rollback(const json& params)
+{
+    reject_unknown_keys(params, {"guardId"}, "proposal.rollback params");
+    const std::string guard_id = require_string(params, "guardId");
+    if (!m_rollback || guard_id != m_rollback->id ||
+        m_rollback->valid_at_revision != m_revision)
+        throw BridgeError("ROLLBACK_GUARD_EXPIRED",
+                          "Rollback guard is missing, stale, or already used");
+
+    Tab& tab = require_process_tab();
+    PresetCollection& collection = *tab.get_presets();
+    const RollbackRecord record = *m_rollback;
+
+    if (!values_match(*tab.get_config(), record.after))
+        throw BridgeError("ROLLBACK_CONFLICT",
+                          "Current settings changed after the proposal was applied");
+
+    if (preserves_created_preset_on_rollback(record.destination)) {
+        Preset* created = collection.find_preset(
+            record.target_preset_name, false, true);
+        if (created == nullptr || !created->is_user())
+            throw BridgeError("ROLLBACK_CONFLICT",
+                              "The newly saved preset is no longer available");
+        if (!collection.select_preset_by_name(record.original_preset_name, true))
+            throw BridgeError("ROLLBACK_CONFLICT",
+                              "The original preset is no longer available");
+        tab.load_current_preset();
+        mark_project_dirty();
+    } else {
+        DynamicPrintConfig restored(*tab.get_config());
+        apply_serialized_values(restored, record.before);
+        tab.load_config(restored);
+        if (record.destination == "update-current-preset") {
+            const Preset& selected = collection.get_selected_preset();
+            if (selected.name != record.original_preset_name ||
+                !selected.is_user() || !selected.can_overwrite())
+                throw BridgeError("ROLLBACK_CONFLICT",
+                                  "The original user preset is no longer selected");
+            tab.save_preset(selected.name, false, false);
+        } else {
+            mark_project_dirty();
+        }
+    }
+
+    advance_revision();
+    clear_rollback();
+    return {
+        {"authority", "orca"},
+        {"status", "rolled-back"},
+        {"rolledBack", true},
+        {"destination", record.destination},
+        {"targetPreset", record.original_preset_name},
+        {"preservedNewPreset",
+            record.destination == "save-as-new-preset"
+                ? json(record.target_preset_name)
+                : json(nullptr)},
+        {"before", record.after},
+        {"after", record.before},
+        {"restored", record.before},
+    };
+}
+
+json PresetAssistantBridge::pending_print_get(const json& params)
+{
+    reject_unknown_keys(params, {"authorization"}, "print.pending.get params");
+    if (require_string(params, "authorization") != "print-archive:read")
+        throw BridgeError("CONSENT_REQUIRED",
+                          "print.pending.get requires print-archive:read authorization");
+    return {
+        {"pending", m_pending_print_archive.is_null()
+            ? json(nullptr)
+            : m_pending_print_archive},
+    };
+}
+
+json PresetAssistantBridge::notify_print_submitted(const std::string& project_name)
+{
+    if (!wxIsMainThread())
+        throw std::runtime_error("Print submission notification must run on Orca's UI thread");
+    PresetBundle& bundle = require_bundle();
+    AppConfig& app_config = require_app_config();
+
+    const auto submitted_at = std::chrono::duration_cast<std::chrono::milliseconds>(
+        std::chrono::system_clock::now().time_since_epoch()).count();
+    const std::string workspace =
+        app_config.get(CONFIG_SECTION, CONFIG_WORKSPACE_KEY);
+
+    m_pending_print_archive = {
+        {"archiveSchemaVersion", 1},
+        {"archiveId", new_id()},
+        {"status", "pending"},
+        {"submittedAtUnixMs", submitted_at},
+        {"projectName", project_name},
+        {"workspace", workspace},
+        {"includeProjectFile", false},
+        {"projectExportSupported", true},
+        {"projectExportMethod", "project.export-copy"},
+        {"projectCopyIncludedByDefault", false},
+        {"presets", current_preset_state(bundle)},
+        {"effectiveSettings", serialized_settings(bundle.full_config())},
+        {"sensitiveConnectionSettingsIncluded", false},
+        {"modelGeometryIncluded", false},
+        {"persistenceOwner", "workspace-helper"},
+    };
+    clear_rollback();
+    advance_revision();
+    m_pending_print_archive["revision"] = m_revision;
+    return m_pending_print_archive;
+}
+
+json PresetAssistantBridge::success_response(
+    const std::string& request_id,
+    json data) const
+{
+    return {
+        {"requestId", request_id},
+        {"ok", true},
+        {"revision", m_revision},
+        {"data", std::move(data)},
+    };
+}
+
+json PresetAssistantBridge::error_response(
+    const std::string& request_id,
+    const std::string& code,
+    const std::string& message) const
+{
+    return {
+        {"requestId", request_id},
+        {"ok", false},
+        {"revision", m_revision},
+        {"error", {
+            {"code", code},
+            {"message", message},
+        }},
+    };
+}
+
+void PresetAssistantBridge::sync_revision()
+{
+    const std::string fingerprint = compute_state_fingerprint();
+    if (m_last_fingerprint.empty()) {
+        m_last_fingerprint = fingerprint;
+        return;
+    }
+    if (fingerprint != m_last_fingerprint) {
+        ++m_revision;
+        m_last_fingerprint = fingerprint;
+        clear_rollback();
+    }
+}
+
+void PresetAssistantBridge::advance_revision()
+{
+    ++m_revision;
+    m_last_fingerprint = compute_state_fingerprint();
+}
+
+std::string PresetAssistantBridge::compute_state_fingerprint() const
+{
+    PresetBundle& bundle = require_bundle();
+    Plater& plater = require_plater();
+    AppConfig& app_config = require_app_config();
+    uint64_t hash = 1469598103934665603ULL;
+
+    hash_add(hash, bundle.printers.get_selected_preset_name());
+    hash_config(hash, bundle.printers.get_edited_preset().config);
+    hash_add(hash, bundle.prints.get_selected_preset_name());
+    hash_config(hash, bundle.prints.get_edited_preset().config);
+    for (const std::string& name : bundle.filament_presets) {
+        hash_add(hash, name);
+        const Preset* filament = bundle.filaments.find_preset(name, false, true);
+        if (filament != nullptr)
+            hash_config(hash, filament->config);
+    }
+    hash_add(hash, plater.is_project_dirty() ? "project-dirty" : "project-clean");
+    hash_add(hash, plater.is_presets_dirty() ? "presets-dirty" : "presets-clean");
+    hash_add(hash, app_config.get(CONFIG_SECTION, CONFIG_WORKSPACE_KEY));
+
+    std::ostringstream stream;
+    stream << std::hex << std::setw(16) << std::setfill('0') << hash;
+    return stream.str();
+}
+
+void PresetAssistantBridge::clear_rollback()
+{
+    m_rollback.reset();
+}
+
+}} // namespace Slic3r::GUI

+#ifndef slic3r_GUI_PresetAssistantBridge_hpp_
+#define slic3r_GUI_PresetAssistantBridge_hpp_
+
+#include <cstdint>
+#include <memory>
+#include <string>
+
+#include <nlohmann/json.hpp>
+
+namespace Slic3r { namespace GUI {
+
+// Narrow native operations surface for the product-owned Preset Assistant page.
+// It is intentionally independent from Electron preload and PluginHost.
+class PresetAssistantBridge final
+{
+public:
+    explicit PresetAssistantBridge(std::string token);
+    ~PresetAssistantBridge();
+
+    nlohmann::json handle_message(const std::string& raw_message,
+                                  const std::string& source_url,
+                                  const std::string& trusted_page_url);
+
+    // Called on the wx UI thread after PrintJob has received an authoritative
+    // success result. The returned payload is emitted to the page and retained
+    // until the workspace helper acknowledges/persists it.
+    nlohmann::json notify_print_submitted(const std::string& project_name);
+
+    uint64_t revision() const { return m_revision; }
+
+    static bool is_trusted_source(const std::string& candidate_url,
+                                  const std::string& trusted_page_url);
+    static bool has_explicit_panel_approval(const nlohmann::json& params);
+    static bool preserves_created_preset_on_rollback(
+        const std::string& destination);
+
+private:
+    struct RollbackRecord;
+
+    nlohmann::json dispatch(const std::string& method, const nlohmann::json& params);
+    nlohmann::json state_get(const nlohmann::json& params);
+    nlohmann::json settings_get(const nlohmann::json& params);
+    nlohmann::json project_get(const nlohmann::json& params);
+    nlohmann::json project_export_copy(const nlohmann::json& params);
+    nlohmann::json workspace_get(const nlohmann::json& params);
+    nlohmann::json workspace_set(const nlohmann::json& params);
+    nlohmann::json workspace_choose(const nlohmann::json& params);
+    nlohmann::json presets_refresh(const nlohmann::json& params);
+    nlohmann::json proposal_apply(const nlohmann::json& params);
+    nlohmann::json proposal_rollback(const nlohmann::json& params);
+    nlohmann::json pending_print_get(const nlohmann::json& params);
+
+    nlohmann::json success_response(const std::string& request_id,
+                                    nlohmann::json data) const;
+    nlohmann::json error_response(const std::string& request_id,
+                                  const std::string& code,
+                                  const std::string& message) const;
+
+    void sync_revision();
+    void advance_revision();
+    std::string compute_state_fingerprint() const;
+    void clear_rollback();
+
+    std::string m_token;
+    uint64_t    m_revision{1};
+    std::string m_last_fingerprint;
+    bool        m_pending_restart{false};
+
+    std::unique_ptr<RollbackRecord> m_rollback;
+    nlohmann::json                  m_pending_print_archive;
+};
+
+}} // namespace Slic3r::GUI
+
+#endif // slic3r_GUI_PresetAssistantBridge_hpp_

+TEST_CASE("Preset Assistant bridge requires explicit panel approval before runtime access",
+          "[PresetAssistant][Bridge]")
+{
+    CHECK(PresetAssistantBridge::has_explicit_panel_approval(
+        {{"approvedAt", "2026-07-29T21:45:00Z"}}));
+    CHECK_FALSE(PresetAssistantBridge::has_explicit_panel_approval(json::object()));
+    CHECK_FALSE(PresetAssistantBridge::has_explicit_panel_approval(
+        {{"approvedAt", ""}}));
+
+    PresetAssistantBridge bridge("test-token");
+    const std::string trusted = "http://localhost:5173/index.html";
+    json value = request("test-token", "proposal.apply");
+    value["expectedRevision"] = 1;
+    value["params"] = {
+        {"destination", "current-project"},
+        {"presetType", "process"},
+        {"expectedPresetName", "0.20mm Standard"},
+        {"changes", {{"layer_height", "0.20"}}},
+        {"reason", "test"},
+    };
+
+    const json response = bridge.handle_message(
+        value.dump(), trusted, trusted);
+    CHECK_FALSE(response["ok"].get<bool>());
+    CHECK(response["error"]["code"] == "CONSENT_REQUIRED");
+}

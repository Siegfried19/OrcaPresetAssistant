+    }
+
+    SECTION("unknown method") {
+        const json response = bridge.handle_message(
+            request("test-token", "filesystem.read").dump(), trusted, trusted);
+        CHECK_FALSE(response["ok"].get<bool>());
+        CHECK(response["error"]["code"] == "UNKNOWN_METHOD");
+    }
+}

+bool is_sensitive_setting_key(const std::string& key)
+{
+    const std::string lower = boost::algorithm::to_lower_copy(key);
+    static constexpr std::array<const char*, 12> denied{
+        "password",
+        "token",
+        "api_key",
+        "apikey",
+        "access_code",
+        "authorization",
+        "username",
+        "user_name",
+        "print_host",
+        "device_id",
+        "serial_number",
+        "cloud",
+    };
+    for (const char* fragment : denied)
+        if (lower.find(fragment) != std::string::npos)
+            return true;
+    return false;
+}
+
+json serialized_settings(const DynamicPrintConfig& config)
+{
+    json result = json::object();
+    std::vector<std::string> keys = config.keys();
+    std::sort(keys.begin(), keys.end());
+    for (const std::string& key : keys) {
+        if (is_sensitive_setting_key(key))
+            continue;
+        try {
+            result[key] = config.opt_serialize(key);
+        } catch (const std::exception& error) {
+            BOOST_LOG_TRIVIAL(warning)
+                << "PresetAssistantBridge: skipped unserializable setting "
+                << key << ": " << error.what();
+        }
+    }
+    return result;
+}
+
+std::string json_value_as_serialized(const json& value, const std::string& key)
+{
+    if (value.is_string())
+        return value.get<std::string>();
+    if (value.is_number() || value.is_boolean())
+        return value.dump();
+    throw BridgeError("INVALID_SETTING_VALUE",
+                      "Setting " + key + " must be a string, number, or boolean");
+}
+
+double validated_layer_height(const std::string& serialized,
+                              const PresetBundle& bundle)
+{
+    size_t consumed = 0;
+    double value = 0.;
+    try {
+        value = std::stod(serialized, &consumed);
+    } catch (const std::exception&) {
+        throw BridgeError("INVALID_SETTING_VALUE",
+                          "layer_height must be a number in millimeters");
+    }
+    if (consumed != serialized.size() || !std::isfinite(value))
+        throw BridgeError("INVALID_SETTING_VALUE",
+                          "layer_height must be a finite number in millimeters");
+
+    const DynamicPrintConfig full_config = bundle.full_config();
+    const auto* nozzles = full_config.option<ConfigOptionFloats>("nozzle_diameter");
+    if (nozzles == nullptr || nozzles->values.empty())
+        throw BridgeError("SETTINGS_NOT_READY",
+                          "Current nozzle diameter is not available");
+    const double max_height =
+        *std::min_element(nozzles->values.begin(), nozzles->values.end()) * 0.8;
+    if (value < 0.04 || value > max_height)
+        throw BridgeError(
+            "SETTING_OUT_OF_RANGE",
+            "layer_height must be between 0.04 mm and 80% of the smallest active nozzle diameter");
+    return value;
+}
+
+struct ValidatedChangeSet
+{
+    DynamicPrintConfig updated;
+    json               deltas = json::object();
+    json               before = json::object();
+    json               after  = json::object();
+};
+
+ValidatedChangeSet validate_process_changes(const json& changes,
+                                            const DynamicPrintConfig& current,
+                                            const PresetBundle& bundle)
+{
+    if (!changes.is_object() || changes.empty())
+        throw BridgeError("INVALID_REQUEST", "changes must be a non-empty object");
+
+    ValidatedChangeSet result{DynamicPrintConfig(current)};
+    for (auto it = changes.begin(); it != changes.end(); ++it) {
+        const std::string key = it.key();
+        if (key != "layer_height")
+            throw BridgeError("UNSUPPORTED_SETTING",
+                              "Unsupported process setting: " + key);
+
+        const std::string serialized = json_value_as_serialized(it.value(), key);
+        (void) validated_layer_height(serialized, bundle);
+
+        const ConfigOption* existing = result.updated.option(key);
+        if (existing == nullptr)
+            throw BridgeError("SETTING_NOT_AVAILABLE",
+                              "Current process setting is not available: " + key);
+
+        std::unique_ptr<ConfigOption> replacement(existing->clone());
+        if (!replacement->deserialize(serialized))
+            throw BridgeError("INVALID_SETTING_VALUE",
+                              "Invalid serialized value for " + key);
+
+        const std::string before = existing->serialize();
+        const std::string after  = replacement->serialize();
+        result.before[key] = before;
+        result.after[key]  = after;
+        result.deltas[key] = {{"before", before}, {"after", after}};
+        result.updated.set_key_value(key, replacement.release());
+    }
+    return result;
+}
+
+void apply_serialized_values(DynamicPrintConfig& target, const json& values)
+{
+    for (auto it = values.begin(); it != values.end(); ++it) {
+        const ConfigOption* existing = target.option(it.key());
+        if (existing == nullptr || !it.value().is_string())
+            throw BridgeError("ROLLBACK_CONFLICT",
+                              "Rollback setting is no longer available: " + it.key());
+        std::unique_ptr<ConfigOption> replacement(existing->clone());
+        if (!replacement->deserialize(it.value().get<std::string>()))
+            throw BridgeError("ROLLBACK_CONFLICT",
+                              "Rollback value is no longer valid: " + it.key());
+        target.set_key_value(it.key(), replacement.release());
+    }
+}
+
+bool values_match(const DynamicPrintConfig& config, const json& expected)
+{
+    for (auto it = expected.begin(); it != expected.end(); ++it) {
+        const ConfigOption* option = config.option(it.key());
+        if (option == nullptr || !it.value().is_string() ||
+            option->serialize() != it.value().get<std::string>())
+            return false;
+    }
+    return true;
+}
+
+fs::path normalized_workspace_path(const std::string& raw)
+{
+    const std::string trimmed = boost::algorithm::trim_copy(raw);
+    if (trimmed.empty())
+        throw BridgeError("INVALID_WORKSPACE", "Workspace path cannot be empty");
+
+    fs::path path(trimmed);
+    path.make_preferred();
+    if (!path.is_absolute())
+        throw BridgeError("INVALID_WORKSPACE", "Workspace path must be absolute");
+    path = fs::absolute(path).lexically_normal().make_preferred();
+    if (path == path.root_path())
+        throw BridgeError("INVALID_WORKSPACE", "Workspace cannot be a filesystem root");
+    return path;
+}
+
+std::string normalized_path_for_compare(const fs::path& value)
+{
+    std::string result = fs::absolute(value).lexically_normal().make_preferred().string();
+#ifdef _WIN32
+    result = boost::algorithm::to_lower_copy(result);
+#endif
+    return result;
+}
+
+bool path_is_within(const fs::path& candidate, const fs::path& root)
+{
+    const std::string candidate_value = normalized_path_for_compare(candidate);
+    std::string root_value = normalized_path_for_compare(root);
+    if (!root_value.empty() &&
+        root_value.back() != fs::path::preferred_separator)
+        root_value.push_back(fs::path::preferred_separator);
+    return boost::algorithm::starts_with(candidate_value, root_value);
+}
+
+std::string validated_new_preset_name(const json& params)
+{
+    const std::string name = boost::algorithm::trim_copy(require_string(params, "newName"));
+    if (name.size() > 128)
+        throw BridgeError("INVALID_PRESET_NAME", "Preset name is too long");
+    if (name == "." || name == ".." || name.back() == '.' || name.back() == ' ')
+        throw BridgeError("INVALID_PRESET_NAME", "Preset name has an unsafe ending");
+    static const std::string forbidden = "<>:\"/\\|?*";
+    for (unsigned char c : name)
+        if (c < 0x20 || forbidden.find(static_cast<char>(c)) != std::string::npos)
+            throw BridgeError("INVALID_PRESET_NAME",
+                              "Preset name contains an unsupported character");
+    return name;
+}
+
+void mark_project_dirty()
+{
+    Plater& plater = require_plater();
+    plater.set_plater_dirty(true);
+    plater.set_current_canvas_as_dirty();
+}
+
+void hash_add(uint64_t& hash, const std::string& value)
+{
+    for (unsigned char c : value) {
+        hash ^= c;
+        hash *= 1099511628211ULL;
+    }
+    hash ^= 0xff;
+    hash *= 1099511628211ULL;
+}
+
+void hash_config(uint64_t& hash, const DynamicPrintConfig& config)
+{
+    std::vector<std::string> keys = config.keys();
+    std::sort(keys.begin(), keys.end());
+    for (const std::string& key : keys) {
+        hash_add(hash, key);
+        try {
+            hash_add(hash, config.opt_serialize(key));
+        } catch (const std::exception&) {
+            hash_add(hash, "<unserializable>");
+        }
+    }
+}
+
+json current_preset_state(PresetBundle& bundle)
+{
+    json filaments = json::array();
+    for (const std::string& name : bundle.filament_presets) {
+        const Preset* preset = bundle.filaments.find_preset(name, false, true);
+        if (preset != nullptr)
+            filaments.push_back(preset_identity(*preset, *preset));
+    }
+    if (filaments.empty()) {
+        filaments.push_back(preset_identity(
+            bundle.filaments.get_selected_preset(),
+            bundle.filaments.get_edited_preset()));
+    }
+
+    return {
+        {"machine", preset_identity(
+            bundle.printers.get_selected_preset(),
+            bundle.printers.get_edited_preset())},
+        {"process", preset_identity(
+            bundle.prints.get_selected_preset(),
+            bundle.prints.get_edited_preset())},
+        {"filaments", std::move(filaments)},
+    };
+}
+
+json vec3_json(const Vec3d& value)
+{
+    return json::array({value.x(), value.y(), value.z()});
+}
+
+json project_placement_summary(Plater& plater)
+{
+    const Model& model = plater.model();
+    PartPlateList& plates = plater.get_partplate_list();
+    json objects = json::array();
+    size_t instance_count = 0;
+
+    for (size_t object_index = 0; object_index < model.objects.size(); ++object_index) {
+        const ModelObject* object = model.objects[object_index];
+        if (object == nullptr)
+            continue;
+
+        json instances = json::array();
+        for (size_t instance_index = 0;
+             instance_index < object->instances.size();
+             ++instance_index) {
+            const ModelInstance* instance = object->instances[instance_index];
+            if (instance == nullptr)
+                continue;
+
+            const int plate_index = plates.find_instance(
+                static_cast<int>(object_index),
+                static_cast<int>(instance_index));
+            const PartPlate* plate =
+                plate_index >= 0 ? plates.get_plate(plate_index) : nullptr;
+            instances.push_back({
+                {"instanceIndex", instance_index},
+                {"labeledId", instance->get_labeled_id()},
+                {"plateIndex", plate_index},
+                {"plateName", plate == nullptr ? std::string() : plate->get_plate_name()},
+                {"offsetMm", vec3_json(instance->get_offset())},
+                {"rotationRadians", vec3_json(instance->get_rotation())},
+                {"scale", vec3_json(instance->get_scaling_factor())},
+                {"mirror", vec3_json(instance->get_mirror())},
+                {"printable", object->printable && instance->printable},
+                {"insidePrintVolume",
+                    instance->print_volume_state == ModelInstancePVS_Inside},
+            });
+            ++instance_count;
+        }
+
+        objects.push_back({
+            {"objectIndex", object_index},
+            {"name", object->name},
+            {"printable", object->printable},
+            {"instances", std::move(instances)},
+        });
+    }
+
+    return {
+        {"objectCount", objects.size()},
+        {"instanceCount", instance_count},
+        {"objects", std::move(objects)},
+        {"units", {
+            {"offset", "millimeter"},
+            {"rotation", "radian"},
+            {"scale", "factor"},
+        }},
+        {"meshIncluded", false},
+        {"sourcePathsIncluded", false},
+    };
+}

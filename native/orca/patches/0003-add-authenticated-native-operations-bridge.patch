+#include <catch2/catch_all.hpp>
+
+#include <nlohmann/json.hpp>
+
+#include "slic3r/GUI/PresetAssistantBridge.hpp"
+
+using Slic3r::GUI::PresetAssistantBridge;
+using json = nlohmann::json;
+
+namespace {
+
+json request(std::string token = "test-token",
+             std::string method = "state.get")
+{
+    return {
+        {"requestId", "request-1"},
+        {"version", 1},
+        {"token", std::move(token)},
+        {"method", std::move(method)},
+        {"params", json::object()},
+    };
+}
+
+} // namespace
+
+TEST_CASE("Preset Assistant bridge accepts only its trusted page origin",
+          "[PresetAssistant][Bridge]")
+{
+    CHECK(PresetAssistantBridge::is_trusted_source(
+        "http://localhost:5173/app",
+        "http://localhost:5173/index.html?lang=en_US"));
+    CHECK(PresetAssistantBridge::is_trusted_source(
+        "https://127.0.0.1:9443/other",
+        "https://127.0.0.1:9443/index.html"));
+    CHECK_FALSE(PresetAssistantBridge::is_trusted_source(
+        "http://localhost:5174/app",
+        "http://localhost:5173/index.html"));
+    CHECK_FALSE(PresetAssistantBridge::is_trusted_source(
+        "https://example.com/",
+        "http://localhost:5173/index.html"));
+

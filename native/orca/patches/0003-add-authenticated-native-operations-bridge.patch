+class BridgeError final : public std::runtime_error
+{
+public:
+    BridgeError(std::string code, std::string message)
+        : std::runtime_error(std::move(message)), code(std::move(code))
+    {}
+
+    std::string code;
+};
+
+std::string new_id()
+{
+    return boost::uuids::to_string(boost::uuids::random_generator()());
+}
+
+void reject_unknown_keys(const json& object,
+                         std::initializer_list<const char*> allowed,
+                         const char* context)
+{
+    if (!object.is_object())
+        throw BridgeError("INVALID_REQUEST", std::string(context) + " must be an object");
+
+    std::set<std::string> accepted;
+    for (const char* key : allowed)
+        accepted.emplace(key);
+    for (auto it = object.begin(); it != object.end(); ++it)
+        if (accepted.find(it.key()) == accepted.end())
+            throw BridgeError("INVALID_REQUEST",
+                              std::string("Unsupported ") + context + " field: " + it.key());
+}
+
+std::string require_string(const json& object, const char* key)
+{
+    auto it = object.find(key);
+    if (it == object.end() || !it->is_string())
+        throw BridgeError("INVALID_REQUEST", std::string("Missing string field: ") + key);
+    const std::string value = it->get<std::string>();
+    if (value.empty())
+        throw BridgeError("INVALID_REQUEST", std::string("Empty string field: ") + key);
+    return value;
+}

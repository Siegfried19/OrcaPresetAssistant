+std::string strip_query_and_fragment(std::string value)
+{
+    const size_t pos = value.find_first_of("?#");
+    if (pos != std::string::npos)
+        value.erase(pos);
+    return value;
+}
+
+int hex_value(char c)
+{
+    if (c >= '0' && c <= '9') return c - '0';
+    if (c >= 'a' && c <= 'f') return c - 'a' + 10;
+    if (c >= 'A' && c <= 'F') return c - 'A' + 10;
+    return -1;
+}
+
+std::string percent_decode(const std::string& value)
+{
+    std::string out;
+    out.reserve(value.size());
+    for (size_t i = 0; i < value.size(); ++i) {
+        if (value[i] == '%' && i + 2 < value.size()) {
+            const int high = hex_value(value[i + 1]);
+            const int low  = hex_value(value[i + 2]);
+            if (high >= 0 && low >= 0) {
+                out.push_back(static_cast<char>((high << 4) | low));
+                i += 2;
+                continue;
+            }
+        }
+        out.push_back(value[i]);
+    }
+    return out;
+}
+
+std::string normalized_file_url(std::string value)
+{
+    value = strip_query_and_fragment(percent_decode(value));
+    if (!boost::algorithm::istarts_with(value, "file:"))
+        return {};
+    value.erase(0, 5);
+    std::replace(value.begin(), value.end(), '\\', '/');
+    while (!value.empty() && value.front() == '/')
+        value.erase(value.begin());
+#ifdef _WIN32
+    value = boost::algorithm::to_lower_copy(value);
+#endif
+    return value;
+}
+
+std::string http_origin(const std::string& value)
+{
+    const std::string lower = boost::algorithm::to_lower_copy(value);
+    size_t scheme_end = lower.find("://");
+    if (scheme_end == std::string::npos)
+        return {};
+    const std::string scheme = lower.substr(0, scheme_end);
+    if (scheme != "http" && scheme != "https")
+        return {};
+    const size_t authority_start = scheme_end + 3;
+    const size_t authority_end = lower.find_first_of("/?#", authority_start);
+    const std::string authority = lower.substr(
+        authority_start,
+        authority_end == std::string::npos ? std::string::npos : authority_end - authority_start);
+    if (authority.empty())
+        return {};
+
+    const bool loopback =
+        authority == "localhost" ||
+        boost::algorithm::starts_with(authority, "localhost:") ||
+        authority == "127.0.0.1" ||
+        boost::algorithm::starts_with(authority, "127.0.0.1:") ||
+        authority == "[::1]" ||
+        boost::algorithm::starts_with(authority, "[::1]:");
+    if (!loopback)
+        return {};
+    return scheme + "://" + authority;
+}

+TEST_CASE("Preset Assistant bridge rejects malformed messages before runtime access",
+          "[PresetAssistant][Bridge]")
+{
+    PresetAssistantBridge bridge("test-token");
+    const std::string trusted = "http://localhost:5173/index.html";
+
+    SECTION("malformed JSON") {
+        const json response = bridge.handle_message(
+            "{not-json", trusted, trusted);
+        CHECK_FALSE(response["ok"].get<bool>());
+        CHECK(response["error"]["code"] == "MALFORMED_JSON");
+    }
+
+    SECTION("missing request id") {
+        json value = request();
+        value.erase("requestId");
+        const json response = bridge.handle_message(
+            value.dump(), trusted, trusted);
+        CHECK_FALSE(response["ok"].get<bool>());
+        CHECK(response["error"]["code"] == "INVALID_REQUEST");
+    }
+
+    SECTION("unexpected envelope field") {
+        json value = request();
+        value["filePath"] = "C:/secret";
+        const json response = bridge.handle_message(
+            value.dump(), trusted, trusted);
+        CHECK_FALSE(response["ok"].get<bool>());
+        CHECK(response["error"]["code"] == "INVALID_REQUEST");
+    }
+
+    SECTION("wrong protocol") {
+        json value = request();
+        value["version"] = 2;
+        const json response = bridge.handle_message(
+            value.dump(), trusted, trusted);
+        CHECK_FALSE(response["ok"].get<bool>());
+        CHECK(response["error"]["code"] == "UNSUPPORTED_PROTOCOL");
+        CHECK(response["requestId"] == "request-1");
+    }
+}

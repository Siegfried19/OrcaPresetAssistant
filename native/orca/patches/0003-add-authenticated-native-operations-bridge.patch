diff --git a/resources/web/orca_preset_assistant/bridge.js b/resources/web/orca_preset_assistant/bridge.js
new file mode 100644
--- /dev/null
+++ b/resources/web/orca_preset_assistant/bridge.js
@@ -0,0 +1,131 @@
+(() => {
+  "use strict";
+
+  const native = window.__ORCA_PRESET_ASSISTANT_NATIVE__;
+  const transport = window.wx;
+  if (!native || native.version !== 1 || !transport?.postMessage) {
+    window.OrcaPresetAssistant = Object.freeze({
+      available: false,
+      request: () =>
+        Promise.reject(
+          Object.assign(new Error("Orca native bridge is unavailable"), {
+            code: "BRIDGE_UNAVAILABLE",
+          }),
+        ),
+    });
+    return;
+  }
+
+  let revision = 1;
+  const pending = new Map();
+  const mutationMethods = new Set([
+    "workspace.set",
+    "workspace.choose",
+    "project.export-copy",
+    "proposal.apply",
+    "proposal.rollback",
+  ]);
+
+  const randomId = () =>
+    globalThis.crypto?.randomUUID?.() ??
+    `request-${Date.now()}-${Math.random().toString(16).slice(2)}`;
+
+  const request = (method, params = {}, options = {}) => {
+    const requestId = randomId();
+    const expectedRevision =
+      options.expectedRevision ?? (mutationMethods.has(method) ? revision : undefined);
+    const envelope = {
+      requestId,
+      version: 1,
+      token: native.token,
+      method,
+      params,
+    };
+    if (expectedRevision !== undefined) {
+      envelope.expectedRevision = expectedRevision;
+    }
+
+    return new Promise((resolve, reject) => {
+      const timeout = window.setTimeout(() => {
+        pending.delete(requestId);
+        reject(
+          Object.assign(new Error(`Native request timed out: ${method}`), {
+            code: "NATIVE_TIMEOUT",
+            requestId,
+          }),
+        );
+      }, options.timeoutMs ?? 15000);
+      pending.set(requestId, { resolve, reject, timeout });
+      transport.postMessage(JSON.stringify(envelope));
+    });
+  };
+
+  window.addEventListener("orca-preset-assistant-response", (event) => {
+    const response = event.detail;
+    if (!response || typeof response.requestId !== "string") return;
+    if (Number.isSafeInteger(response.revision)) revision = response.revision;
+    const waiter = pending.get(response.requestId);
+    if (!waiter) return;
+    pending.delete(response.requestId);
+    window.clearTimeout(waiter.timeout);
+    if (response.ok) {
+      waiter.resolve(response);
+      return;
+    }
+    const error = Object.assign(
+      new Error(response.error?.message ?? "Native request failed"),
+      {
+        code: response.error?.code ?? "NATIVE_ERROR",
+        requestId: response.requestId,
+        revision: response.revision,
+      },
+    );
+    waiter.reject(error);
+  });
+
+  window.addEventListener(
+    "orca-preset-assistant-print-submitted",
+    (event) => {
+      if (Number.isSafeInteger(event.detail?.revision)) {
+        revision = event.detail.revision;
+      }
+      window.dispatchEvent(
+        new CustomEvent("orca-preset-assistant:print-submitted", {
+          detail: event.detail,
+        }),
+      );
+    },
+  );
+
+  window.OrcaPresetAssistant = Object.freeze({
+    available: true,
+    request,
+    get revision() {
+      return revision;
+    },
+    state: () => request("state.get"),
+    settings: () =>
+      request("settings.get", { authorization: "settings:read" }),
+    project: () =>
+      request("project.get", { authorization: "project:summary" }),
+    projectPlacement: () =>
+      request("project.get", { authorization: "project:placement" }),
+    exportProjectCopy: (destinationPath) =>
+      request("project.export-copy", {
+        authorization: "project:export-copy",
+        destinationPath,
+      }),
+    workspace: () => request("workspace.get"),
+    chooseWorkspace: () => request("workspace.choose"),
+    setWorkspace: (workspace) =>
+      request("workspace.set", { workspace }),
+    refreshPresets: () => request("presets.refresh"),
+    applyProposal: (proposal) => request("proposal.apply", proposal),
+    rollbackProposal: (guardId) =>
+      request("proposal.rollback", { guardId }),
+    pendingPrintArchive: () =>
+      request("print.pending.get", {
+        authorization: "print-archive:read",
+      }),
+  });
+})();

+void ParamsPanel::show_preset_assistant_update(
+    const wxString& preset_name,
+    const wxString& destination,
+    const std::vector<PresetAssistantNoticeChange>& changes,
+    std::function<bool(wxString&)> rollback)
+{
+    if (!m_preset_assistant_notice ||
+        !m_preset_assistant_details_sizer)
+        return;
+
+    m_preset_assistant_rollback = std::move(rollback);
+    m_preset_assistant_details_expanded = false;
+    m_preset_assistant_title->SetLabel(preset_assistant_text(
+        "Current preset updated", "当前预设已更新"));
+    const wxString change_count = wxString::Format(
+        "%llu", static_cast<unsigned long long>(changes.size()));
+    m_preset_assistant_summary->SetLabel(
+        preset_name + " · " + destination + " · " + change_count +
+        preset_assistant_text(" changes", " 项修改"));
+    m_preset_assistant_details_button->SetLabel(
+        preset_assistant_text("View changes", "查看修改"));
+    m_preset_assistant_undo_button->SetLabel(
+        preset_assistant_text("Undo", "撤销"));
+    m_preset_assistant_undo_button->Enable(
+        static_cast<bool>(m_preset_assistant_rollback));
+
+    m_preset_assistant_details_sizer->Clear(true);
+    m_preset_assistant_details_sizer->Add(
+        new wxStaticText(
+            m_preset_assistant_details, wxID_ANY,
+            preset_assistant_text("Parameter", "参数")),
+        0, wxALIGN_CENTER_VERTICAL);
+    m_preset_assistant_details_sizer->Add(
+        new wxStaticText(
+            m_preset_assistant_details, wxID_ANY,
+            preset_assistant_text("Before", "修改前")),
+        0, wxALIGN_CENTER_VERTICAL | wxALIGN_RIGHT);
+    m_preset_assistant_details_sizer->Add(
+        new wxStaticText(
+            m_preset_assistant_details, wxID_ANY,
+            preset_assistant_text("After", "修改后")),
+        0, wxALIGN_CENTER_VERTICAL | wxALIGN_RIGHT);
+
+    for (const PresetAssistantNoticeChange& change : changes) {
+        wxString before = change.before;
+        wxString after = change.after;
+        if (!change.unit.empty()) {
+            before += " " + change.unit;
+            after += " " + change.unit;
+        }
+        m_preset_assistant_details_sizer->Add(
+            new wxStaticText(
+                m_preset_assistant_details, wxID_ANY, change.label),
+            0, wxALIGN_CENTER_VERTICAL);
+        m_preset_assistant_details_sizer->Add(
+            new wxStaticText(
+                m_preset_assistant_details, wxID_ANY, before),
+            0, wxALIGN_CENTER_VERTICAL | wxALIGN_RIGHT);
+        m_preset_assistant_details_sizer->Add(
+            new wxStaticText(
+                m_preset_assistant_details, wxID_ANY, after),
+            0, wxALIGN_CENTER_VERTICAL | wxALIGN_RIGHT);
+    }
+
+    m_preset_assistant_details->Hide();
+    m_preset_assistant_details->Layout();
+    m_preset_assistant_notice->Show();
+    if (m_left_sizer)
+        m_left_sizer->Layout();
+    Layout();
+}
+
+void ParamsPanel::mark_preset_assistant_update_rolled_back()
+{
+    if (!m_preset_assistant_notice)
+        return;
+    m_preset_assistant_title->SetLabel(preset_assistant_text(
+        "Update rolled back", "本次更新已撤销"));
+    m_preset_assistant_summary->SetLabel(preset_assistant_text(
+        "The previous values are active; the history record is kept.",
+        "修改前的参数已恢复，历史记录仍然保留。"));
+    m_preset_assistant_undo_button->SetLabel(
+        preset_assistant_text("Undone", "已撤销"));
+    m_preset_assistant_undo_button->Disable();
+    m_preset_assistant_rollback = {};
+    m_preset_assistant_notice->Layout();
+    if (m_left_sizer)
+        m_left_sizer->Layout();
+}
+
+void ParamsPanel::clear_preset_assistant_rollback_handler()
+{
+    m_preset_assistant_rollback = {};
+    if (m_preset_assistant_undo_button)
+        m_preset_assistant_undo_button->Disable();
+}
+
+void ParamsPanel::toggle_preset_assistant_details()
+{
+    if (!m_preset_assistant_details)
+        return;
+    m_preset_assistant_details_expanded =
+        !m_preset_assistant_details_expanded;
+    m_preset_assistant_details->Show(
+        m_preset_assistant_details_expanded);
+    m_preset_assistant_details_button->SetLabel(
+        m_preset_assistant_details_expanded
+            ? preset_assistant_text("Hide changes", "收起修改")
+            : preset_assistant_text("View changes", "查看修改"));
+    m_preset_assistant_notice->Layout();
+    if (m_left_sizer)
+        m_left_sizer->Layout();
+    Layout();
+}
+
+void ParamsPanel::request_preset_assistant_rollback()
+{
+    if (!m_preset_assistant_rollback)
+        return;
+    const std::function<bool(wxString&)> rollback =
+        m_preset_assistant_rollback;
+    wxString error;
+    if (rollback(error)) {
+        mark_preset_assistant_update_rolled_back();
+        return;
+    }
+
+    m_preset_assistant_title->SetLabel(preset_assistant_text(
+        "Undo is no longer available", "无法撤销本次更新"));
+    m_preset_assistant_summary->SetLabel(
+        error.empty()
+            ? preset_assistant_text(
+                  "Settings changed after this update.",
+                  "更新后参数已再次发生变化。")
+            : error);
+    clear_preset_assistant_rollback_handler();
+    m_preset_assistant_notice->Layout();
+    if (m_left_sizer)
+        m_left_sizer->Layout();
+}

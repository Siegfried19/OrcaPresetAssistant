+bool PresetAssistantBridge::rollback_latest_from_params_panel(
+    std::string& error_message)
+{
+    error_message.clear();
+    try {
+        if (!wxIsMainThread())
+            throw BridgeError(
+                "UI_THREAD_REQUIRED",
+                "Preset rollback must run on Orca's UI thread");
+
+        sync_revision();
+        if (!m_rollback)
+            throw BridgeError(
+                "ROLLBACK_GUARD_EXPIRED",
+                "Settings changed after this update");
+
+        const std::string guard_id = m_rollback->id;
+        (void) proposal_rollback({{"guardId", guard_id}});
+        return true;
+    } catch (const BridgeError& error) {
+        if (error.code != "ROLLBACK_GUARD_EXPIRED" &&
+            error.code != "ROLLBACK_CONFLICT")
+            error_message = error.what();
+        return false;
+    } catch (const std::exception& error) {
+        error_message = error.what();
+        return false;
+    }
+}
+
+void PresetAssistantBridge::publish_params_panel_update(
+    const std::string& preset_type,
+    const std::string& preset_name,
+    const std::string& destination,
+    const json& deltas)
+{
+    if (!wxIsMainThread())
+        return;
+    ParamsPanel* panel = wxGetApp().params_panel();
+    if (panel == nullptr)
+        return;
+
+    Tab& tab = require_preset_tab(preset_type);
+    const DynamicPrintConfig* config = tab.get_config();
+    std::vector<PresetAssistantNoticeChange> changes;
+    changes.reserve(deltas.size());
+    for (auto it = deltas.begin(); it != deltas.end(); ++it) {
+        PresetAssistantNoticeChange change;
+        change.label = from_u8(it.key());
+        if (config != nullptr && config->def() != nullptr) {
+            if (const ConfigOptionDef* definition = config->def()->get(it.key())) {
+                const std::string label = definition->full_label.empty()
+                    ? definition->label
+                    : definition->full_label;
+                if (!label.empty())
+                    change.label = wxGetTranslation(from_u8(label));
+                if (!definition->sidetext.empty())
+                    change.unit = wxGetTranslation(from_u8(definition->sidetext));
+            }
+        }
+        change.before = from_u8(
+            it.value().value("before", std::string()));
+        change.after = from_u8(
+            it.value().value("after", std::string()));
+        changes.emplace_back(std::move(change));
+    }
+
+    const bool chinese =
+        wxGetApp().current_language_code_safe().StartsWith("zh");
+    wxString destination_label;
+    if (destination == "current-project")
+        destination_label = wxString::FromUTF8(
+            chinese ? "当前项目" : "Current project");
+    else if (destination == "update-current-preset")
+        destination_label = wxString::FromUTF8(
+            chinese ? "更新当前预设" : "Updated current preset");
+    else
+        destination_label = wxString::FromUTF8(
+            chinese ? "另存为新预设" : "Saved as new preset");
+
+    panel->show_preset_assistant_update(
+        from_u8(preset_name),
+        destination_label,
+        changes,
+        [this](wxString& message) {
+            std::string error;
+            const bool rolled_back =
+                rollback_latest_from_params_panel(error);
+            message = from_u8(error);
+            return rolled_back;
+        });
+}
 

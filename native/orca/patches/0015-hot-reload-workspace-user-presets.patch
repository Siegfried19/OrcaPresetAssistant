+    write_preset_info(json_file);
+    REQUIRE(bundle.prints.reload_user_preset_from_file(
+        json_file.string(), "Protected Reload", ForwardCompatibilitySubstitutionRule::Disable).first != nullptr);
+    REQUIRE(bundle.prints.select_preset_by_name("Protected Reload", true));
+    bundle.prints.get_edited_preset().config.option<ConfigOptionFloat>("layer_height", true)->value = 0.28;
+    REQUIRE(bundle.prints.current_is_dirty());
+
+    CHECK_THROWS(bundle.prints.reload_user_preset_from_file(
+        json_file.string(), "Protected Reload", ForwardCompatibilitySubstitutionRule::Disable));
+    CHECK(bundle.prints.get_edited_preset().config.option<ConfigOptionFloat>("layer_height")->value == Catch::Approx(0.28));
+
+    REQUIRE(bundle.prints.select_preset_by_name(bundle.prints.default_preset().name, true));

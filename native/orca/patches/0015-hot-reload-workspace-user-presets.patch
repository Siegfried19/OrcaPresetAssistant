+    CHECK(added.second);
+    CHECK(added.first->config.option<ConfigOptionFloat>("layer_height")->value == Catch::Approx(0.20));
+
+    DynamicPrintConfig second(bundle.prints.default_preset().config);
+    second.option<ConfigOptionFloat>("layer_height", true)->value = 0.24;
+    second.save_to_json(json_file.string(), "Hot Reload", "User", "1.0.0");
+    auto updated = bundle.prints.reload_user_preset_from_file(
+        json_file.string(), "Hot Reload", ForwardCompatibilitySubstitutionRule::Disable);
+    REQUIRE(updated.first != nullptr);

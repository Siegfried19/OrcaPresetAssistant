+                    {"presetName", preset.name},
+                    {"relativePath", preset.relative_path},
+                    {"selected", preset.selected},
+                    {"replacementPreset", preset.selected ? json(preset.replacement_name) : json(nullptr)},
+                });
+            } catch (const BridgeError& error) {
+                errors.push_back({{"id", error_id}, {"code", error.code}, {"message", error.what()}});
+            } catch (const std::exception& error) {
+                errors.push_back({{"id", error_id}, {"code", "PRESET_UNLOAD_FAILED"}, {"message", error.what()}});
+            }
+        }
+    };
+    unload_missing_workspace_presets("process");
+    unload_missing_workspace_presets("filament");

+std::pair<Preset*, bool> PresetCollection::reload_user_preset_from_file(
+    const std::string &path,
+    const std::string &expected_name,
+    ForwardCompatibilitySubstitutionRule substitution_rule)
+{
+    const PresetOrigin user_origin(PresetOrigin::Kind::User);
+    const std::string canonical_name = this->canonical_preset_name(expected_name, user_origin);
+    fs::path source = fs::absolute(fs::path(path)).make_preferred();
+    if (!fs::exists(source) || !fs::is_regular_file(source) || !Slic3r::is_json_file(source.filename().string()))
+        throw Slic3r::RuntimeError("User preset JSON does not exist: " + source.string());
+    fs::path source_info(source);
+    source_info.replace_extension(".info");
+    if (!fs::exists(source_info) || !fs::is_regular_file(source_info))
+        throw Slic3r::RuntimeError("User preset metadata does not exist: " + source_info.string());
+
+    Preset *existing = this->find_preset(canonical_name, false, true);
+    const bool created = existing == nullptr;
+    const bool selected = !created && this->get_selected_preset().name == canonical_name;
+    if (existing != nullptr &&
+        (existing->is_system || existing->is_default || existing->is_project_embedded || !existing->is_user()))
+        throw Slic3r::RuntimeError("Only an existing user preset may be hot-reloaded");
+    if (selected && this->current_is_dirty())
+        throw Slic3r::RuntimeError("The selected preset has unsaved Orca edits");
+
+    const fs::path temporary_dir = fs::temp_directory_path() /
+        fs::unique_path("orca-preset-reload-%%%%-%%%%-%%%%");
+    fs::create_directories(temporary_dir);
+    struct TemporaryDirectoryGuard {
+        fs::path path;
+        ~TemporaryDirectoryGuard() {
+            boost::system::error_code ignored;
+            fs::remove_all(path, ignored);
+        }
+    } cleanup{temporary_dir};
+
+    const fs::path temporary_json = temporary_dir / source.filename();
+    fs::path temporary_info(temporary_json);
+    temporary_info.replace_extension(".info");
+    fs::copy_file(source, temporary_json, fs::copy_option::overwrite_if_exists);
+    fs::copy_file(source_info, temporary_info, fs::copy_option::overwrite_if_exists);
+
+    PresetCollection scratch;
+    scratch = *this;
+    auto scratch_existing = scratch.find_preset_internal(canonical_name);
+    if (scratch_existing != scratch.m_presets.end() && scratch_existing->name == canonical_name)
+        scratch.m_presets.erase(scratch_existing);
+    scratch.m_idx_selected = 0;
+    scratch.m_edited_preset = scratch.m_presets.front();
+    scratch.m_saved_preset = scratch.m_presets.front();
+
+    PresetsConfigSubstitutions substitutions;
+    scratch.load_presets(
+        temporary_dir.string(),
+        "",
+        substitutions,
+        substitution_rule,
+        nullptr,
+        user_origin);
+    Preset *parsed = scratch.find_preset(canonical_name, false, true);
+    if (parsed == nullptr || !parsed->loaded)
+        throw Slic3r::RuntimeError("Orca could not parse the user preset");
+    Preset replacement(*parsed);
+    replacement.file = source.string();
+
+    const std::string selected_name_before = this->get_selected_preset().name;
+    const Preset edited_before(m_edited_preset);
+    const Preset saved_before(m_saved_preset);
+    if (existing != nullptr) {
+        auto existing_it = this->find_preset_internal(canonical_name);
+        if (existing_it == m_presets.end() || existing_it->name != canonical_name)
+            throw Slic3r::RuntimeError("The existing user preset could not be located");
+        m_presets.erase(existing_it);
+    }
+    m_presets.emplace_back(std::move(replacement));
+    sort_presets();
+    Preset *reloaded = this->find_preset(canonical_name, false, true);
+    if (reloaded == nullptr)
+        throw Slic3r::RuntimeError("The reloaded user preset was not registered");
+    set_custom_preset_alias(*reloaded);
+
+    if (selected) {
+        if (!this->select_preset_by_name(canonical_name, true))
+            throw Slic3r::RuntimeError("The selected user preset could not be refreshed");
+    } else {
+        auto selected_it = this->find_preset_internal(selected_name_before);
+        if (selected_it == m_presets.end() || selected_it->name != selected_name_before)
+            throw Slic3r::RuntimeError("The previous preset selection was lost");
+        m_idx_selected = static_cast<size_t>(std::distance(m_presets.begin(), selected_it));
+        m_edited_preset = edited_before;
+        m_saved_preset = saved_before;
+    }
+    return {reloaded, created};
+}
+
+bool PresetCollection::unload_user_preset(
+    const std::string &name,
+    const std::string &replacement_name)
+{
+    Preset *existing = this->find_preset(name, false, true);
+    if (existing == nullptr)
+        return false;
+    if (existing->is_system || existing->is_default || existing->is_project_embedded || !existing->is_user())
+        throw Slic3r::RuntimeError("Only a workspace user preset may be hot-unloaded");
+
+    const std::string canonical_name = existing->name;
+    const bool selected = this->get_selected_preset().name == canonical_name;
+    if (selected && this->current_is_dirty())
+        throw Slic3r::RuntimeError("The selected preset has unsaved Orca edits");
+    for (const Preset &candidate : m_presets)
+        if (candidate.name != canonical_name && candidate.inherits() == canonical_name)
+            throw Slic3r::RuntimeError("A preset inherited by another preset cannot be hot-unloaded");
+
+    const std::string selected_after = selected ? replacement_name : this->get_selected_preset().name;
+    auto selected_after_it = this->find_preset_internal(this->canonical_preset_name(selected_after));
+    if (selected_after.empty() || selected_after == canonical_name ||
+        selected_after_it == m_presets.end() || selected_after_it->name != selected_after ||
+        !selected_after_it->is_visible)
+        throw Slic3r::RuntimeError("A safe replacement preset is unavailable");
+
+    const Preset edited_before(m_edited_preset);
+    const Preset saved_before(m_saved_preset);
+    auto existing_it = this->find_preset_internal(canonical_name);
+    if (existing_it == m_presets.end() || existing_it->name != canonical_name)
+        throw Slic3r::RuntimeError("The user preset could not be located");
+    m_presets.erase(existing_it);
+
+    selected_after_it = this->find_preset_internal(this->canonical_preset_name(selected_after));
+    if (selected_after_it == m_presets.end() || selected_after_it->name != selected_after)
+        throw Slic3r::RuntimeError("The previous preset selection was lost");
+    const size_t selected_after_idx = static_cast<size_t>(std::distance(m_presets.begin(), selected_after_it));
+    if (selected) {
+        this->select_preset(selected_after_idx);
+    } else {
+        m_idx_selected = selected_after_idx;
+        m_edited_preset = edited_before;
+        m_saved_preset = saved_before;
+    }
+    return true;
+}

+
+const WriteRule* find_write_rule(const std::string& preset_type,
+                                 const std::string& key)
+{
+    if (preset_type == "process") {
+        for (const WriteRule& rule : process_write_rules())
+            if (key == rule.key)
+                return &rule;
+    } else if (preset_type == "filament") {
+        for (const WriteRule& rule : filament_write_rules())
+            if (key == rule.key)
+                return &rule;
+    }
+    return nullptr;
+}
+
+const char* scalar_kind_name(ScalarKind kind)
+{
+    switch (kind) {
+    case ScalarKind::Boolean: return "boolean";
+    case ScalarKind::Integer: return "integer";
+    case ScalarKind::Number:  return "number";
+    case ScalarKind::Percent: return "percent";
+    }
+    return "unknown";
+}
+
+json serialized_write_rule(const WriteRule& rule)
+{
+    json result{
+        {"key", rule.key},
+        {"valueShape", "scalar"},
+        {"kind", scalar_kind_name(rule.scalar_kind)},
+        {"minimum", rule.minimum},
+        {"unit", rule.unit},
+    };
+    if (rule.dynamic_layer_max) {
+        result["maximum"] = nullptr;
+        result["dynamicMaximum"] = "80-percent-of-smallest-active-nozzle";
+    } else {
+        result["maximum"] = rule.maximum;
+    }
+    return result;
+}
+
+double parse_scalar_value(std::string serialized,
+                          const WriteRule& rule,
+                          const std::string& key)
+{
+    boost::algorithm::trim(serialized);
+    if (serialized.empty() ||
+        serialized.find(',') != std::string::npos ||
+        serialized.find(';') != std::string::npos)
+        throw BridgeError(
+            "INVALID_SETTING_VALUE",
+            "Setting " + key + " must contain exactly one scalar value");
+
+    if (rule.scalar_kind == ScalarKind::Percent &&
+        !serialized.empty() && serialized.back() == '%') {
+        serialized.pop_back();
+        boost::algorithm::trim(serialized);
+    }
+
+    size_t consumed = 0;
+    double value = 0.;
+    try {
+        value = std::stod(serialized, &consumed);
+    } catch (const std::exception&) {
+        throw BridgeError(
+            "INVALID_SETTING_VALUE",
+            "Setting " + key + " must be a finite " +
+                scalar_kind_name(rule.scalar_kind));
+    }
+    if (consumed != serialized.size() || !std::isfinite(value))
+        throw BridgeError(
+            "INVALID_SETTING_VALUE",
+            "Setting " + key + " must be a finite " +
+                scalar_kind_name(rule.scalar_kind));
+    if (rule.scalar_kind == ScalarKind::Integer && std::floor(value) != value)
+        throw BridgeError(
+            "INVALID_SETTING_VALUE",
+            "Setting " + key + " must be an integer");
+    return value;
+}
+
+double maximum_for_rule(const WriteRule& rule,
+                        const PresetBundle& bundle)
+{
+    if (!rule.dynamic_layer_max)
+        return rule.maximum;
+
+    const DynamicPrintConfig full_config = bundle.full_config();
+    const auto* nozzles =
+        full_config.option<ConfigOptionFloats>("nozzle_diameter");
+    if (nozzles == nullptr || nozzles->values.empty())
+        throw BridgeError(
+            "SETTINGS_NOT_READY",
+            "Current nozzle diameter is not available");
+    return *std::min_element(
+               nozzles->values.begin(), nozzles->values.end()) *
+           0.8;
+}
+
+void validate_rule_value(const json& request_value,
+                         const ConfigOption& replacement,
+                         const WriteRule& rule,
+                         const PresetBundle& bundle)
+{
+    if (rule.scalar_kind == ScalarKind::Boolean) {
+        if (!request_value.is_boolean())
+            throw BridgeError(
+                "INVALID_SETTING_VALUE",
+                "Setting " + std::string(rule.key) + " must be a JSON boolean");
+        return;
+    }
+    if (request_value.is_boolean() ||
+        (!request_value.is_number() && !request_value.is_string()))
+        throw BridgeError(
+            "INVALID_SETTING_VALUE",
+            "Setting " + std::string(rule.key) + " must be a number or numeric string");
+
+    const double value =
+        parse_scalar_value(replacement.serialize(), rule, rule.key);
+    const double maximum = maximum_for_rule(rule, bundle);
+    if (value < rule.minimum || value > maximum) {
+        std::ostringstream message;
+        message << "Setting " << rule.key << " must be between "
+                << rule.minimum << " and " << maximum << " " << rule.unit;
+        throw BridgeError("SETTING_OUT_OF_RANGE", message.str());
+    }
+}
 

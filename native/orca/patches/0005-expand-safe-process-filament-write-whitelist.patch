+TEST_CASE("Preset Assistant exposes only the controlled preset write surface",
+          "[PresetAssistant][Bridge]")
+{
+    CHECK(PresetAssistantBridge::is_preset_type_writable("process"));
+    CHECK(PresetAssistantBridge::is_preset_type_writable("filament"));
+    CHECK_FALSE(PresetAssistantBridge::is_preset_type_writable("machine"));
+    CHECK_FALSE(PresetAssistantBridge::is_preset_type_writable("printer"));
+
+    CHECK(PresetAssistantBridge::is_supported_write_setting(
+        "process", "layer_height"));
+    CHECK(PresetAssistantBridge::is_supported_write_setting(
+        "process", "outer_wall_acceleration"));
+    CHECK(PresetAssistantBridge::is_supported_write_setting(
+        "process", "enable_support"));
+    CHECK(PresetAssistantBridge::is_supported_write_setting(
+        "filament", "nozzle_temperature"));
+    CHECK(PresetAssistantBridge::is_supported_write_setting(
+        "filament", "filament_flow_ratio"));
+    CHECK(PresetAssistantBridge::is_supported_write_setting(
+        "filament", "fan_max_speed"));
+    CHECK_FALSE(PresetAssistantBridge::is_supported_write_setting(
+        "machine", "nozzle_diameter"));
+    CHECK_FALSE(PresetAssistantBridge::is_supported_write_setting(
+        "process", "machine_start_gcode"));
+    CHECK_FALSE(PresetAssistantBridge::is_supported_write_setting(
+        "filament", "filament_start_gcode"));
+
+    const json capabilities = PresetAssistantBridge::write_capabilities();
+    REQUIRE(capabilities["process"]["settings"].is_array());
+    REQUIRE(capabilities["filament"]["settings"].is_array());
+    CHECK(capabilities["process"]["access"] == "controlled-write");
+    CHECK(capabilities["filament"]["access"] == "controlled-write");
+    CHECK(capabilities["machine"]["access"] == "read-only");
+    CHECK(capabilities["machine"]["settings"].empty());
+    CHECK(capabilities["process"]["settings"].size() == 18);
+    CHECK(capabilities["filament"]["settings"].size() == 16);
+
+    const json layer_rule = capabilities["process"]["settings"].front();
+    CHECK(layer_rule["key"] == "layer_height");
+    CHECK(layer_rule["minimum"] == 0.04);
+    CHECK(layer_rule["maximum"].is_null());
+    CHECK(layer_rule["dynamicMaximum"] ==
+          "80-percent-of-smallest-active-nozzle");
+}
